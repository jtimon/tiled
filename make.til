mode cli

// Run from the repository root: til interpret make.til
// std/ resolves against the installed compiler's matching support tree.
// Core and GUI support are loaded from that same installed distribution.
import("std/sys")

build := proc(name: Str, source: Str) {
    cmd := Cmd.new()
    cmd.arg("til")
    cmd.arg("build")
    cmd.arg("-o")
    cmd.arg(format("bin/", name))
    cmd.arg("-c")
    cmd.arg(format("gen/", name, ".c"))
    cmd.arg(source)
    cmd.run_checked()
}

main := proc(args: ..Str) {
    if mkdir_p("bin") != 0 { panic("could not create bin/") }
    if mkdir_p("gen") != 0 { panic("could not create gen/") }
    if args.len() == 1 && args[0] == "summary" {
        Cmd.new("til", "run", "-o", "bin/issues_summary", "-c", "gen/issues_summary.c", "examples/issues.til").run_checked()
        return
    }
    if args.len() > 0 { panic("usage: til interpret make.til [summary]") }
    build("tiled", "src/tiled.til")
    build("tilminal", "src/tilminal.til")
}
