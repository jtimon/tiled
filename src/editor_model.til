mode lib
import("../gen/terminal_api")
import("tabs")
import("undo_tree")

// Buffers own text or reference host-owned terminals. Leaves own views;
// branches own layout decisions, never native terminal resources.
EditorBuffer := struct {
    session_id : I64 = 0
    alive := true
    filename := ""
    text := ""
    dirty := false
    disk_text := ""
    label := ""
    recovery_note := ""
    restored_terminal := false
    saved_directory := ""
    undo := UndoTree()
    needs_save := false
    // Native sessions live in the host's owning pool, not in clonable layout data.
    terminal : I64 = -1
    terminal_name := ""
    terminal_running := false
    terminal_status : I64 = 0
}

EditorView := struct {
    buffer : USize = 0
    cursor : USize = 0
    mark : USize = 0
    mark_active := false
    mark_explicit := false
    dragging := false
    scroll_y : I32 = 0
    scroll_x : I32 = 0
    terminal_viewport := TerminalViewport.new()
namespace:
    selected := func(v: EditorView) returns Bool { return v.mark_active && v.mark != v.cursor }
    selection_start := func(v: EditorView) returns USize {
        if v.selected() && v.mark < v.cursor { return v.mark }
        return v.cursor
    }
    selection_end := func(v: EditorView) returns USize {
        if v.selected() && v.mark > v.cursor { return v.mark }
        return v.cursor
    }
    clear_mark := func(mut v: EditorView) { v.mark_active = false; v.mark_explicit = false; v.dragging = false }
}

EditorRect := struct {
    x : I32 = 0
    y : I32 = 0
    width : I32 = 0
    height : I32 = 0
}

EditorNode := struct {
    session_id : I64 = 0
    alive := true
    parent : I32 = -1
    first : I32 = -1
    second : I32 = -1
    side_by_side := false
    view := EditorView()
    history := Vec(EditorView).new()
    tabs := TabGroup()
    rect := EditorRect()
}

editor_content_rect := func(rect: EditorRect, tabs_visible: Bool, tab_height: I32) returns EditorRect {
    mut out := rect.clone()
    if tabs_visible {
        out.y = out.y + tab_height
        out.height = out.height - tab_height
        if out.height < 0 { out.height = 0 }
    }
    return out
}

editor_buffer_name := func(buffer: EditorBuffer) returns Str {
    if buffer.terminal >= 0 { return buffer.terminal_name.clone() }
    if buffer.label.len() > 0 { return buffer.label.clone() }
    if buffer.filename.len() == 0 { return "*draft*" }
    start := (buffer.filename.rfind("/") + 1).to_usize()
    return buffer.filename.substr(start, buffer.filename.len() - start).clone()
}

editor_adjust_point := func(mut view: EditorView, start: USize, count: USize, added: USize) {
    view.clear_mark()
    end := start + count
    if view.cursor > end || (count > 0 && view.cursor == end) {
        view.cursor = view.cursor - count + added
    } else if view.cursor > start {
        view.cursor = start
    }
}

text_next := func(text: Str, cursor: USize) returns USize {
    mut pos := cursor
    if pos < text.len() { pos++ }
    while pos < text.len() {
        if text.get(pos).cast(I64).band(192) != 128 { break }
        pos++
    }
    return pos
}
text_previous := func(text: Str, cursor: USize) returns USize {
    mut pos := cursor
    if pos > 0 { pos-- }
    while pos > 0 {
        if text.get(pos).cast(I64).band(192) != 128 { break }
        pos--
    }
    return pos
}
text_row_start := func(text: Str, row: I32) returns USize {
    mut pos : USize = 0
    mut line : I32 = 0
    while pos < text.len() && line < row {
        if text.get(pos) == '\n' { line++ }
        pos++
    }
    return pos
}

text_line_start := func(text: Str, cursor: USize) returns USize {
    mut pos := cursor
    while pos > 0 {
        if text.get(pos - 1) == '\n' { break }
        pos--
    }
    return pos
}

text_line_end := func(text: Str, cursor: USize) returns USize {
    mut pos := cursor
    while pos < text.len() {
        if text.get(pos) == '\n' { break }
        pos++
    }
    return pos
}

text_row := func(text: Str, cursor: USize) returns I32 {
    mut row : I32 = 0
    mut i : USize = 0
    while i < cursor {
        if text.get(i) == '\n' { row = row + 1 }
        i++
    }
    return row
}

EditorState := struct {
    buffers : Vec(EditorBuffer)
    nodes : Vec(EditorNode)
    focused : USize = 0
    next_session_id : I64 = 3
    tabs_visible := true
    edit_time_ms : I64 = 0
    undo_serial : I64 = 0
    undo_token : I64 = 0
    undo_label := "edit"

namespace:
    new := func(filename: Str, text: Str) returns EditorState {
        mut buffers := Vec(EditorBuffer).new()
        buffers.push(own EditorBuffer(session_id = 1, filename = filename.clone(), text = text.clone(), disk_text = text.clone()))
        mut nodes := Vec(EditorNode).new()
        nodes.push(own EditorNode(session_id = 2, tabs = TabGroup.single(0)))
        return EditorState(buffers = buffers, nodes = nodes)
    }

    add_node := func(mut self: EditorState, node: EditorNode) returns USize {
        mut added := node.clone()
        added.session_id = self.next_session_id; self.next_session_id = self.next_session_id + 1
        mut i : USize = 0
        while i < self.nodes.len() {
            if !self.nodes[i].alive {
                self.nodes.set(i, own added)!
                return i
            }
            i++
        }
        self.nodes.push(own added)
        return i
    }

    arrange := func(mut self: EditorState, index: USize, rect: EditorRect) {
        ref mut placed : EditorNode = self.nodes[index]
        placed.rect = rect.clone()
        first := self.nodes[index].first
        second := self.nodes[index].second
        if first < 0 { return }
        if self.nodes[index].side_by_side {
            mut gap : I32 = 4
            if rect.width < gap { gap = rect.width }
            half := (rect.width - gap) / 2
            self.arrange(first.to_usize(), EditorRect(x = rect.x, y = rect.y,
                width = half, height = rect.height))
            self.arrange(second.to_usize(), EditorRect(x = rect.x + half + gap, y = rect.y,
                width = rect.width - half - gap, height = rect.height))
        } else {
            mut gap : I32 = 4
            if rect.height < gap { gap = rect.height }
            half := (rect.height - gap) / 2
            self.arrange(first.to_usize(), EditorRect(x = rect.x, y = rect.y,
                width = rect.width, height = half))
            self.arrange(second.to_usize(), EditorRect(x = rect.x, y = rect.y + half + gap,
                width = rect.width, height = rect.height - half - gap))
        }
    }

    split := func(mut self: EditorState, side_by_side: Bool, min_width: I32, min_height: I32) returns Bool {
        self.edit_boundary()
        index := self.focused
        rect := self.nodes[index].rect.clone()
        if side_by_side {
            if rect.width < min_width * 2 + 4 { return false }
        } else {
            if rect.height < min_height * 2 + 4 { return false }
        }
        // Copy before pushes, which may reallocate the node vector.
        view := self.nodes[index].view.clone()
        history := self.nodes[index].history.clone()
        mut tabs := self.nodes[index].tabs.clone()
        tabs.dragging = false
        first := self.add_node(EditorNode(parent = index.to_i32(), view = view.clone(), history = history.clone(), tabs = tabs.clone()))
        second := self.add_node(EditorNode(parent = index.to_i32(), view = view.clone(), history = history.clone(), tabs = tabs.clone()))
        ref mut branch : EditorNode = self.nodes[index]
        branch.first = first.to_i32()
        branch.second = second.to_i32()
        branch.side_by_side = side_by_side
        self.focused = first
        return true
    }

    collect_views := func(self: EditorState, index: USize, mut out: Vec(USize)) {
        ref node : EditorNode = self.nodes[index]
        if node.first < 0 {
            out.push(own index)
        } else {
            self.collect_views(node.first.to_usize(), out)
            self.collect_views(node.second.to_usize(), out)
        }
    }

    views := func(self: EditorState) returns Vec(USize) {
        mut out := Vec(USize).new()
        self.collect_views(0, out)
        return out
    }

    next_view := func(mut self: EditorState) {
        self.edit_boundary()
        order := self.views()
        mut i : USize = 0
        while i < order.len() {
            if order[i] == self.focused {
                self.focused = order[(i + 1).mod(order.len())]
                return
            }
            i++
        }
    }

    close_view := func(mut self: EditorState) returns Bool {
        self.edit_boundary()
        index := self.focused
        parent := self.nodes[index].parent
        if parent < 0 { return false }
        parent_index := parent.to_usize()
        ref branch : EditorNode = self.nodes[parent_index]
        mut sibling := branch.first
        if sibling == index.to_i32() { sibling = branch.second }
        grandparent := branch.parent
        mut replacement := self.nodes[sibling.to_usize()].clone()
        replacement.parent = grandparent
        self.nodes.set(parent_index, own replacement)!
        ref mut removed : EditorNode = self.nodes[index]
        removed.alive = false
        ref mut promoted : EditorNode = self.nodes[sibling.to_usize()]
        promoted.alive = false
        first := self.nodes[parent_index].first
        second := self.nodes[parent_index].second
        if first >= 0 {
            ref mut first_child : EditorNode = self.nodes[first.to_usize()]
            first_child.parent = parent
            ref mut second_child : EditorNode = self.nodes[second.to_usize()]
            second_child.parent = parent
        }
        self.focused = parent_index
        // Keep the lookup in the body: Til 0.0.1-2827886a4 hoists an indexed
        // while-condition lookup even when the body changes its index.
        while true {
            child := self.nodes[self.focused].first
            if child < 0 { break }
            self.focused = child.to_usize()
        }
        return true
    }

    only_view := func(mut self: EditorState) {
        self.edit_boundary()
        view := self.nodes[self.focused].view.clone()
        history := self.nodes[self.focused].history.clone()
        mut nodes := Vec(EditorNode).new()
        nodes.push(own EditorNode(session_id = self.nodes[self.focused].session_id, view = view, history = history,
            tabs = self.nodes[self.focused].tabs.clone()))
        self.nodes = nodes
        self.focused = 0
    }

    live_buffers := func(self: EditorState) returns Vec(USize) {
        mut out := Vec(USize).new()
        for id in 0..self.buffers.len() {
            if self.buffers[id].alive { out.push(own id) }
        }
        return out
    }

    // Same-basename files use their full paths in the chooser. Scratch keeps
    // its reserved display name even alongside a file named "*draft*".
    buffer_name := func(self: EditorState, id: USize) returns Str {
        ref buffer : EditorBuffer = self.buffers[id]
        name := editor_buffer_name(buffer)
        if buffer.filename.len() == 0 { return name }
        for other : USize in self.live_buffers() {
            if other != id && editor_buffer_name(self.buffers[other]) == name {
                return buffer.filename.clone()
            }
        }
        return name
    }

    add_buffer := func(mut self: EditorState, filename: Str, text: Str) returns USize {
        buffer := EditorBuffer(session_id = self.next_session_id, filename = filename.clone(), text = text.clone(), disk_text = text.clone())
        self.next_session_id = self.next_session_id + 1
        for id in 0..self.buffers.len() {
            if !self.buffers[id].alive {
                self.buffers.set(id, own buffer.clone())!
                return id
            }
        }
        id := self.buffers.len()
        self.buffers.push(own buffer)
        return id
    }

    select_buffer := func(mut self: EditorState, index: USize, id: USize) {
        self.edit_boundary()
        assert(self.buffers[id].alive)
        ref mut node : EditorNode = self.nodes[index]
        node.tabs.add(id)
        if node.view.buffer == id { return }
        mut view := EditorView(buffer = id)
        mut history := Vec(EditorView).new()
        for saved : EditorView in node.history {
            if saved.buffer == id { view = saved.clone() }
            else { history.push(own saved.clone()) }
        }
        history.push(own node.view.clone())
        node.history = history
        node.view = view
    }

    switch_buffer := func(mut self: EditorState, id: USize) {
        self.select_buffer(self.focused, id)
    }
    new_draft := func(mut self: EditorState) {
        mut number : I64 = 1
        mut name := "*draft*"
        while true {
            mut used := false
            for id : USize in self.live_buffers() { if editor_buffer_name(self.buffers[id]) == name { used = true; break } }
            if !used { break }
            number = number + 1; name = format("*draft-", number.to_str(), "*")
        }
        id := self.add_buffer("", "")
        ref mut buffer : EditorBuffer = self.buffers[id]
        buffer.label = name
        self.switch_buffer(id)
    }
    cycle_tab := func(mut self: EditorState, direction: I64) {
        ref node : EditorNode = self.nodes[self.focused]
        id := node.tabs.adjacent(node.view.buffer, direction)
        self.switch_buffer(id)
    }
    move_tab := func(mut self: EditorState, direction: I64) {
        ref mut node : EditorNode = self.nodes[self.focused]
        node.tabs.move(node.view.buffer, direction)
    }
    hide_tab := func(mut self: EditorState) {
        index := self.focused
        id := self.nodes[index].view.buffer
        mut replacement := id
        if self.nodes[index].tabs.items.len() > 1 { replacement = self.nodes[index].tabs.adjacent(id, 1) }
        else {
            for other : USize in self.live_buffers() { if other != id { replacement = other.clone(); break } }
            if replacement == id { self.new_draft(); replacement = self.nodes[index].view.buffer }
        }
        self.select_buffer(index, replacement)
        self.nodes[index].tabs.remove(id)
    }

    other_buffer := func(self: EditorState, index: USize) returns USize {
        ref node : EditorNode = self.nodes[index]
        if node.history.len() > 0 { return node.history[node.history.len() - 1].buffer }
        for id : USize in self.live_buffers() {
            if id != node.view.buffer { return id.clone() }
        }
        return node.view.buffer
    }

    show_buffer := func(mut self: EditorState, filename: Str, text: Str) {
        mut id : USize = 0
        while id < self.buffers.len() {
            if self.buffers[id].alive && self.buffers[id].terminal < 0 && self.buffers[id].filename == filename { break }
            id++
        }
        if id == self.buffers.len() {
            id = self.add_buffer(filename, text)
        }
        self.switch_buffer(id)
    }

    // Killing a buffer never closes a view or writes its file. Every affected
    // view selects another live buffer; an empty draft replaces the last one.
    kill_buffer := func(mut self: EditorState, id: USize, discard: Bool = false) returns Bool {
        assert(self.buffers[id].alive)
        if (self.buffers[id].dirty || self.buffers[id].terminal_running) && !discard { return false }
        if self.live_buffers().len() == 1 { self.add_buffer("", "") }
        for index : USize in self.views() {
            if self.nodes[index].view.buffer == id {
                replacement := self.other_buffer(index)
                self.select_buffer(index, replacement)
            }
            mut history := Vec(EditorView).new()
            for saved : EditorView in self.nodes[index].history {
                if saved.buffer != id { history.push(own saved.clone()) }
            }
            ref mut node : EditorNode = self.nodes[index]
            node.history = history
            node.tabs.remove(id)
        }
        self.buffers.set(id, own EditorBuffer(alive = false))!
        return true
    }

    move_cursor := func(mut self: EditorState, key: I32) {
        self.edit_boundary()
        ref mut view : EditorView = self.nodes[self.focused].view
        assert(self.buffers[view.buffer].terminal < 0)
        ref text : Str = self.buffers[view.buffer].text
        start := text_line_start(text, view.cursor)
        end := text_line_end(text, view.cursor)
        column := view.cursor - start
        if key == 263 { view.cursor = text_previous(text, view.cursor) }
        if key == 262 { view.cursor = text_next(text, view.cursor) }
        if key == 268 { view.cursor = start }
        if key == 269 { view.cursor = end }
        if key == 265 && start > 0 {
            previous := text_line_start(text, start - 1)
            mut offset := column
            if offset > start - 1 - previous { offset = start - 1 - previous }
            view.cursor = previous + offset
        }
        if key == 264 && end < text.len() {
            next := end + 1
            next_end := text_line_end(text, next)
            mut offset := column
            if offset > next_end - next { offset = next_end - next }
            view.cursor = next + offset
        }
        while view.cursor > 0 && view.cursor < text.len() {
            if text.get(view.cursor).cast(I64).band(192) != 128 { break }
            view.cursor--
        }
    }

    select_move := func(mut self: EditorState, key: I32, extend: Bool) {
        ref mut view : EditorView = self.nodes[self.focused].view
        if extend || view.mark_explicit {
            if !view.mark_active { view.mark = view.cursor; view.mark_active = true }
        } else { view.clear_mark() }
        self.move_cursor(key)
    }
    selected_text := func(self: EditorState) returns Str {
        ref v : EditorView = self.nodes[self.focused].view
        return self.buffers[v.buffer].text.substr(v.selection_start(), v.selection_end() - v.selection_start()).clone()
    }
    cut_selection := func(mut self: EditorState) {
        ref v : EditorView = self.nodes[self.focused].view
        if v.selected() { self.replace(v.selection_start(), v.selection_end() - v.selection_start(), "") }
    }

    edit_boundary := func(mut self: EditorState) {
        if self.undo_token == 0 { self.buffers[self.nodes[self.focused].view.buffer].undo.boundary() }
    }
    begin_edit_command := func(mut self: EditorState, name: Str, grouped_deletion: Bool = false) {
        self.undo_label = name.clone()
        self.undo_token = 0
        if !grouped_deletion {
            self.edit_boundary()
            self.undo_serial = self.undo_serial + 1; self.undo_token = self.undo_serial
        }
    }
    end_edit_command := func(mut self: EditorState) { self.undo_token = 0 }

    mark_saved := func(mut self: EditorState, id: USize) {
        ref mut buffer : EditorBuffer = self.buffers[id]
        buffer.disk_text = buffer.text.clone()
        buffer.needs_save = false; buffer.dirty = false
        buffer.undo.mark_saved()
    }

    priv apply_change := func(mut self: EditorState, id: USize, start: USize, count: USize, inserted: Str) {
        ref mut buffer : EditorBuffer = self.buffers[id]
        assert(buffer.terminal < 0)
        end := start + count
        assert(end <= buffer.text.len())
        replacement := format(buffer.text.substr(0, start), inserted,
            buffer.text.substr(end, buffer.text.len() - end))
        buffer.text = replacement
        buffer.dirty = buffer.needs_save || buffer.text != buffer.disk_text
        // Other views retain their own points, adjusted for the shared edit.
        mut i : USize = 0
        while i < self.nodes.len() {
            ref mut node : EditorNode = self.nodes[i]
            if node.alive && node.first < 0 {
                if node.view.buffer == id {
                    editor_adjust_point(node.view, start, count, inserted.len())
                }
                for saved_index in 0..node.history.len() {
                    ref mut saved : EditorView = node.history[saved_index]
                    if saved.buffer == id {
                        editor_adjust_point(saved, start, count, inserted.len())
                    }
                }
            }
            i++
        }
    }

    replace := func(mut self: EditorState, start: USize, count: USize, inserted: Str, kind: I64 = 0) {
        id := self.nodes[self.focused].view.buffer
        ref mut buffer : EditorBuffer = self.buffers[id]
        assert(buffer.terminal < 0 && start + count <= buffer.text.len())
        removed := buffer.text.substr(start, count).clone()
        if removed == inserted {
            ref mut view : EditorView = self.nodes[self.focused].view
            view.cursor = start + inserted.len(); view.clear_mark()
            self.edit_boundary()
            return
        }
        before := self.nodes[self.focused].view.cursor
        after := start + inserted.len()
        buffer.undo.record(UndoEdit(start = start, removed = removed, inserted = inserted.clone()), before, after,
            self.nodes[self.focused].session_id, self.edit_time_ms, kind, self.undo_token, self.undo_label, !buffer.dirty)
        self.apply_change(id, start, count, inserted)
        ref mut view : EditorView = self.nodes[self.focused].view
        view.cursor = after
    }

    type_text := func(mut self: EditorState, text: Str) {
        ref v : EditorView = self.nodes[self.focused].view
        self.undo_label = "typing"
        mut kind : I64 = 1
        if v.selected() || text.contains("\n") { kind = 0 }
        self.replace(v.selection_start(), v.selection_end() - v.selection_start(), text, kind)
    }

    undo_edit := func(mut self: EditorState) returns Bool {
        id := self.nodes[self.focused].view.buffer
        ref mut buffer : EditorBuffer = self.buffers[id]
        assert(buffer.terminal < 0)
        buffer.undo.boundary()
        if buffer.undo.nodes.len() == 0 || buffer.undo.current == 0 { return false }
        index := buffer.undo.current
        node := buffer.undo.nodes[index].clone()
        mut i := node.edits.len()
        while i > 0 {
            i--
            ref edit : UndoEdit = node.edits[i]
            assert(buffer.text.substr(edit.start, edit.inserted.len()) == edit.inserted)
            self.apply_change(id, edit.start, edit.inserted.len(), edit.removed)
        }
        buffer.undo.current = node.parent.to_usize()
        buffer.undo.prefer(buffer.undo.current, index)
        ref mut view : EditorView = self.nodes[self.focused].view
        view.cursor = node.before
        return true
    }
    redo_edit := func(mut self: EditorState) returns Bool {
        id := self.nodes[self.focused].view.buffer
        ref mut buffer : EditorBuffer = self.buffers[id]
        assert(buffer.terminal < 0)
        buffer.undo.boundary()
        next := buffer.undo.redo_node()
        if next < 0 { return false }
        node := buffer.undo.nodes[next.to_usize()].clone()
        for edit : UndoEdit in node.edits {
            assert(buffer.text.substr(edit.start, edit.removed.len()) == edit.removed)
            self.apply_change(id, edit.start, edit.removed.len(), edit.inserted)
        }
        buffer.undo.current = next.to_usize()
        ref mut view : EditorView = self.nodes[self.focused].view
        view.cursor = node.after
        return true
    }
    undo_to := func(mut self: EditorState, target: USize) {
        id := self.nodes[self.focused].view.buffer
        ref mut tree : UndoTree = self.buffers[id].undo
        assert(target < tree.nodes.len())
        mut path := Vec(USize).new()
        mut at := target
        while true {
            path.push(own at.clone())
            if at == 0 { break }
            at = tree.nodes[at].parent.to_usize()
        }
        while true {
            mut common := false
            for node : USize in path { if node == tree.current { common = true; break } }
            if common { break }
            changed := self.undo_edit(); assert(changed)
        }
        while tree.current != target {
            mut next := target
            while true {
                parent := tree.nodes[next].parent.to_usize()
                if parent == tree.current { break }
                next = parent
            }
            tree.prefer(tree.current, next)
            changed := self.redo_edit(); assert(changed)
        }
        tree.boundary()
    }

    insert := func(mut self: EditorState, text: Str) {
        ref v : EditorView = self.nodes[self.focused].view
        self.replace(v.selection_start(), v.selection_end() - v.selection_start(), text)
    }

    backspace := func(mut self: EditorState, grouped: Bool = false) {
        if self.nodes[self.focused].view.selected() { self.cut_selection(); return }
        cursor := self.nodes[self.focused].view.cursor
        start := text_previous(self.buffers[self.nodes[self.focused].view.buffer].text, cursor)
        mut kind : I64 = 0
        if grouped { kind = 2; self.undo_label = "backspace" }
        if cursor > 0 { self.replace(start, cursor - start, "", kind) }
    }

    delete_forward := func(mut self: EditorState, grouped: Bool = false) {
        if self.nodes[self.focused].view.selected() { self.cut_selection(); return }
        ref view : EditorView = self.nodes[self.focused].view
        cursor := view.cursor
        mut kind : I64 = 0
        if grouped { kind = 3; self.undo_label = "delete" }
        if cursor < self.buffers[view.buffer].text.len() { self.replace(cursor, text_next(self.buffers[view.buffer].text, cursor) - cursor, "", kind) }
    }
}
