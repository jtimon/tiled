mode lib
import("editor_model")
import("keymap")

EditorAction := proc(mut EditorState)
EditorUserCommand := struct { name : Str; callback : EditorAction }
EditorCommands := struct {
    keys := Keymaps()
    callbacks := Vec(EditorUserCommand).new()
namespace:
    new := func() returns EditorCommands {
        mut c := EditorCommands()
        terminal_keymaps(c.keys)
        discovery_keymaps(c.keys)
        c.keys.bind("text", "C-h k", "describe-key")
        for name : Str in array(Str, "quit", "save-buffer", "session-save", "find-file", "switch-buffer", "list-buffers", "kill-buffer", "new-terminal",
            "split-below", "split-right", "other-view", "close-view", "only-view", "send-prefix", "set-mark", "cut",
            "left", "right", "up", "down", "home", "end", "newline", "backspace", "delete", "accept", "complete", "previous-choice", "next-choice") { c.keys.declare(name) }
        c.bind("global", "C-x C-c", "quit")
        c.bind("global", "C-x C-s", "save-buffer")
        c.bind("global", "C-x C-f", "find-file")
        c.bind("global", "C-x b", "switch-buffer")
        c.bind("global", "C-x C-b", "list-buffers")
        c.bind("global", "C-x k", "kill-buffer")
        c.bind("global", "C-x t", "new-terminal")
        c.bind("global", "C-x 2", "split-below")
        c.bind("global", "C-x 3", "split-right")
        c.bind("global", "C-x o", "other-view")
        c.bind("global", "C-x 0", "close-view")
        c.bind("global", "C-x 1", "only-view")
        c.bind("terminal", "C-x C-x", "send-prefix")
        c.bind("prefix", "Escape", "quit")
        c.bind("text", "C-g", "cancel")
        c.bind("text", "Escape", "quit")
        c.bind("text", "C-s", "save-buffer")
        c.bind("text", "M-s", "save-buffer")
        c.bind("text", "C-o", "find-file")
        c.bind("text", "M-o", "find-file")
        c.bind("text", "C-Space", "set-mark")
        c.bind("text", "M-w", "copy", true)
        c.bind("text", "C-c", "copy", true)
        c.bind("text", "C-S-c", "copy", true)
        c.bind("text", "C-w", "cut", true)
        c.bind("text-selection", "C-x", "cut")
        c.bind("text", "C-y", "paste", true)
        c.bind("text", "C-v", "paste", true)
        c.bind("text", "C-S-v", "paste", true)
        c.bind("text", "Enter", "newline", true)
        c.bind("text", "Backspace", "backspace", true)
        c.bind("text", "Delete", "delete", true)
        for key : Str in array(Str, "Left", "Right", "Up", "Down", "Home", "End") {
            mut command := "left"
            if key == "Right" { command = "right" }
            if key == "Up" { command = "up" }
            if key == "Down" { command = "down" }
            if key == "Home" { command = "home" }
            if key == "End" { command = "end" }
            c.bind("text", key, command, true)
            c.bind("text", format("S-", key), command, true)
        }
        return c
    }
    bind := func(mut c: EditorCommands, map: Str, keys: Str, command: Str, repeat: Bool = false) { c.keys.bind(map, keys, command, repeat) }
    unbind := func(mut c: EditorCommands, map: Str, keys: Str) { c.keys.unbind(map, keys) }
    user_names := func(c: EditorCommands) returns Vec(Str) {
        mut names := Vec(Str).new()
        for entry : EditorUserCommand in c.callbacks { names.push(own entry.name.clone()) }
        return names
    }
    command := func(mut c: EditorCommands, name: Str, callback: EditorAction) {
        if name == "forward-key" { panic("forward-key is reserved for bypassing host dispatch") }
        c.keys.declare(name)
        value := EditorUserCommand(name = name.clone(), callback = callback)
        for i in 0..c.callbacks.len() {
            if c.callbacks[i].name == name { c.callbacks.set(i, own value)!; return }
        }
        c.callbacks.push(own value)
    }
    invoke := proc(c: EditorCommands, name: Str, mut editor: EditorState) returns Bool {
        // Installed Til does not infer effects through a stored proc pointer.
        noop_proc()
        for entry : EditorUserCommand in c.callbacks {
            if entry.name == name {
                callback := entry.callback
                callback(editor)
                return true
            }
        }
        return false
    }
}
