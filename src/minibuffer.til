mode lib

// Prompt mechanics are independent of editor commands and rendering.
MinibufferChoice := struct {
    id : USize = 0
    name := ""
    marker := ""
    detail := ""
}

Minibuffer := struct {
    active := false
    label := ""
    input := ""
    cursor : USize = 0
    choices := Vec(MinibufferChoice).new()
    selected : USize = 0
    hint := ""

namespace:
    begin := func(mut self: Minibuffer, label: Str, choices: Vec(MinibufferChoice)) {
        self.active = true
        self.label = label.clone()
        self.input = ""
        self.cursor = 0
        self.choices = choices.clone()
        self.selected = 0
        self.hint = ""
    }

    matches := func(self: Minibuffer) returns Vec(USize) {
        mut out := Vec(USize).new()
        for index in 0..self.choices.len() {
            ref choice : MinibufferChoice = self.choices[index]
            if choice.name.contains(self.input) || choice.detail.contains(self.input) {
                out.push(own index)
            }
        }
        return out
    }

    refresh := func(mut self: Minibuffer) {
        self.selected = 0
        self.hint = ""
        matches := self.matches()
        for index in 0..matches.len() {
            if self.choices[matches[index]].name == self.input {
                self.selected = index
                return
            }
        }
    }

    choice := func(self: Minibuffer) returns I64 {
        matches := self.matches()
        if matches.len() == 0 { return -1 }
        return matches[self.selected].to_i64()
    }

    insert := func(mut self: Minibuffer, text: Str) {
        self.input = format(self.input.substr(0, self.cursor), text,
            self.input.substr(self.cursor, self.input.len() - self.cursor))
        self.cursor = self.cursor + text.len()
        self.refresh()
    }

    key := func(mut self: Minibuffer, key: I32, shift: Bool) {
        if key == 263 && self.cursor > 0 { self.cursor-- }
        if key == 262 && self.cursor < self.input.len() { self.cursor++ }
        if key == 268 { self.cursor = 0 }
        if key == 269 { self.cursor = self.input.len() }
        if key == 259 && self.cursor > 0 {
            self.input = format(self.input.substr(0, self.cursor - 1),
                self.input.substr(self.cursor, self.input.len() - self.cursor))
            self.cursor--
            self.refresh()
        }
        if key == 261 && self.cursor < self.input.len() {
            self.input = format(self.input.substr(0, self.cursor),
                self.input.substr(self.cursor + 1, self.input.len() - self.cursor - 1))
            self.refresh()
        }
        matches := self.matches()
        if matches.len() == 0 { return }
        if key == 265 || (key == 258 && shift) {
            self.selected = (self.selected + matches.len() - 1).mod(matches.len())
        }
        if key == 264 { self.selected = (self.selected + 1).mod(matches.len()) }
        if key == 258 && !shift {
            self.input = self.choices[matches[self.selected]].name.clone()
            self.cursor = self.input.len()
            self.refresh()
        }
    }
}
