mode lib

import("std/sys")
import("../lib/libterminal/view")
import("../gen/terminal_api")
import("../gen/terminal_profile")
import("window_input")
import("terminal_clipboard")
import("keymap")
import("session_window")
import("tilminal_session")
import("command_discovery")
import("minibuffer_view")

TilminalAction := proc(mut Terminal, mut TerminalViewport)
TilminalUserCommand := struct { name : Str; callback : TilminalAction }
TilminalCommands := struct {
    keys := Keymaps()
    callbacks := Vec(TilminalUserCommand).new()
namespace:
    new := func() returns TilminalCommands {
        mut c := TilminalCommands()
        terminal_keymaps(c.keys)
        discovery_keymaps(c.keys)
        c.keys.declare("quit")
        c.keys.declare("session-save")
        c.keys.bind("prefix", "Escape", "cancel")
        return c
    }
    bind := func(mut c: TilminalCommands, map: Str, keys: Str, command: Str, repeat: Bool = false) { c.keys.bind(map, keys, command, repeat) }
    unbind := func(mut c: TilminalCommands, map: Str, keys: Str) { c.keys.unbind(map, keys) }
    user_names := func(c: TilminalCommands) returns Vec(Str) {
        mut names := Vec(Str).new()
        for entry : TilminalUserCommand in c.callbacks { names.push(own entry.name.clone()) }
        return names
    }
    command := func(mut c: TilminalCommands, name: Str, callback: TilminalAction) {
        if name == "forward-key" { panic("forward-key is reserved for bypassing host dispatch") }
        c.keys.declare(name)
        value := TilminalUserCommand(name = name.clone(), callback = callback)
        for i in 0..c.callbacks.len() {
            if c.callbacks[i].name == name { c.callbacks.set(i, own value)!; return }
        }
        c.callbacks.push(own value)
    }
    invoke := proc(c: TilminalCommands, name: Str, mut terminal: Terminal, mut viewport: TerminalViewport) returns Bool {
        noop_proc() // Stored proc effects are not inferred by installed Til.
        for entry : TilminalUserCommand in c.callbacks {
            if entry.name == name {
                callback := entry.callback
                callback(terminal, viewport)
                return true
            }
        }
        return false
    }
}
TilminalConfig := struct {
    commands := TilminalCommands.new()
    session := SessionConfig()
    font_path := ""
    font_size : I32 = 28
}

// Use the same system monospace selection as Tiled. No font path depends on
// a Til source checkout, the executable's directory, or the shell's cwd.
tilminal_font_path := proc(config: TilminalConfig) returns Str {
    if config.font_path.len() > 0 { return config.font_path.clone() }
    query := Cmd.new("fc-match", "--format=%{file}", "monospace")
    query.capture_out()
    if query.run() != 0 { panic("cannot resolve terminal font; install fontconfig") }
    path := query.out()
    if path.len() == 0 { panic("fontconfig found no monospace font") }
    return path
}

start_tilminal := proc(config: TilminalConfig, args: ..Str) {
    if config.font_size <= 0 { panic("config.font_size must be positive") }
    options := SessionArgs.parse(..args)
    mut settings := config.session.clone()
    // One-shot invocations must not overwrite the interactive default session.
    if options.has_operand && options.name.len() == 0 { settings.enabled = false }
    mut session := SessionStore.new("tilminal", settings, options)
    mut shell := get_env("SHELL")
    windows := host_os() == "windows"
    if windows {
        shell = get_env("COMSPEC")
        if shell.len() == 0 { shell = "cmd.exe" }
    } else if shell.len() == 0 { shell = "/bin/sh" }
    mut terminal := Terminal.new(shell)
    terminal.session.set_directory(get_cwd_str())
    if TERMINAL_TERMINFO.len() > 0 { terminal.session.set_profile("tilminal", TERMINAL_TERMINFO) }
    if options.has_operand {
        if windows { terminal.session.arg("/C") } else { terminal.session.arg("-c") }
        terminal.session.arg(options.operand)
    } else if windows.not() { terminal.session.arg("-i") }

    SetConfigFlags(FLAG_WINDOW_RESIZABLE.cast(U32))
    InitWindow(960, 640, "tilminal".c_str)
    SetWindowMinSize(320, 200)
    SetExitKey(0) // Escape belongs to the foreground terminal application.
    window_init_input()
    SetTargetFPS(60)
    font_path := tilminal_font_path(config)
    mut view := TerminalView.new(font_path, config.font_size)
    footer_h := view.cell_height + 8
    mut viewport := TerminalViewport.new()
    mut key_state := KeyState()
    mut discovery := CommandDiscovery()
    mut notice := ""
    mut notice_until : F64 = 0.0
    mut frame := SessionFrame(width = 960, height = 640)
    mut restored_output := ""
    if tilminal_restore_session(session, terminal, frame, restored_output) { session_restore_window(frame) }
    // Apply the actual window/font metrics before replaying saved output.
    // Replaying into the model's default 80-column grid and then shrinking it
    // crops text when a larger font needs fewer columns.
    PollInputEvents()
    terminal.resize(GetScreenWidth().cast(I64) / view.cell_width, GetScreenHeight().cast(I64) / view.cell_height)
    if restored_output.len() > 0 { terminal_restore_text(terminal.screen, restored_output) }
    if session.notice.len() > 0 { println(session.notice) }
    terminal.start()
    mut last_title := "tilminal"
    mut checkpoint_at := GetTime()
    mut checkpoint_now := false
    while true {
        width := GetScreenWidth().cast(I64)
        height := GetScreenHeight().cast(I64)
        terminal.resize(width / view.cell_width, height / view.cell_height)
        terminal.pump()
        if session.enabled && (checkpoint_now || GetTime() >= checkpoint_at) {
            checkpoint_now = false
            checkpoint_at = GetTime() + settings.interval_ms.to_f64() / 1000.0
            if !session.save(tilminal_checkpoint(terminal, session_window_frame())) { println(session.notice) }
        }
        viewport.sync(terminal.screen)
        discovery.refresh(config.commands.keys, "terminal", "terminal", viewport.selection.active(), !terminal.screen.alternate_active)
        if !discovery.active() { terminal_mouse(viewport, terminal.screen, view.cell_width, view.cell_height, 0, 0, width, height) }
        wheel := GetMouseWheelMove()
        if wheel != 0 && !discovery.active() { viewport.scroll(terminal.screen, (wheel * 3).to_i64()) }
        mut mods : I32 = 0
        mut action : I32 = 0
        mut key := window_next_event(mods, action)
        mut closing := false
        while key > 0 {
            if action == 4 { closing = true; break }
            mut dispatch := KeyDispatch()
            if discovery.reading {
                key_state.consume(key, mods, action)
                dispatch = discovery.event(config.commands.keys, KeyDispatch(), key, mods, action)
            } else {
                mut context := "terminal"
                if discovery.active() { context = "minibuffer" }
                key_state.context(context)
                dispatch = key_state.event(config.commands.keys, context, viewport.selection.active(), !terminal.screen.alternate_active, key, mods, action)
                if discovery.active() {
                    if dispatch.command == "forward-key" { key_state.consume(key, mods, action) }
                    dispatch = discovery.event(config.commands.keys, dispatch, key, mods, action)
                }
            }
            if discovery.message.len() > 0 {
                notice = discovery.message.clone(); notice_until = GetTime() + 10.0; discovery.message = ""
            }
            if dispatch.kind == 0 { terminal_forward(viewport, terminal, key.cast(I64), mods, action) }
            else if dispatch.kind == 1 {
                name := dispatch.command
                if config.commands.invoke(name, terminal, viewport) {
                } else if name == "execute-command" || name == "describe-key" {
                    discovery.begin(config.commands.keys, "terminal", "terminal", viewport.selection.active(), !terminal.screen.alternate_active,
                        false, config.commands.user_names(), name == "describe-key")
                } else if name == "quit" { closing = true; break }
                else if name == "session-save" { checkpoint_now = true }
                else if name == "forward-key" { terminal_forward(viewport, terminal, key.cast(I64), mods, action) }
                else if !terminal_command(viewport, terminal, name, height / view.cell_height) {
                    notice = format("Unavailable in terminal: ", name); notice_until = GetTime() + 10.0
                }
            }
            key = window_next_event(mods, action)
        }
        window_drain_input()
        if closing {
            if session.enabled {
                if !session.seal(tilminal_checkpoint(terminal, session_window_frame())) { println(session.notice) }
            }
            break
        }
        mut title := "tilminal"
        if terminal.ended { title = format(title, " [exit ", terminal.session.status().to_str(), "]") }
        if viewport.offset > 0 { title = format(title, " [scrollback ", viewport.offset.to_str(), "]") }
        if key_state.pending.len() > 0 { title = format(title, " [prefix]") }
        if discovery.active() { title = format(title, " [command]") }
        if title != last_title {
            SetWindowTitle(title.c_str)
            last_title = title
        }
        BeginDrawing()
        ClearBackground(Color(r = 16, g = 18, b = 24, a = 255))
        view.draw_scrolled(terminal.screen, 0, 0, width, height, IsWindowFocused() && !discovery.active(), terminal.ended, viewport.offset, viewport.selection)
        if discovery.active() {
            draw_minibuffer(discovery.mini, view.font, view.font_size, view.cell_height.to_i32(), width.to_i32(), height.to_i32(), footer_h.to_i32())
        } else if notice.len() > 0 && GetTime() < notice_until {
            DrawRectangle(0, (height - footer_h).to_i32(), width.to_i32(), footer_h.to_i32(), Color(r = 24, g = 28, b = 42, a = 255))
            BeginScissorMode(8, (height - footer_h).to_i32(), (width - 16).to_i32(), footer_h.to_i32())
            minibuffer_text(view.font, notice, 8, (height - footer_h + 4).to_i32(), view.font_size, Color(r = 240, g = 230, b = 190, a = 255))
            EndScissorMode()
        }
        EndDrawing()
    }
    terminal.close()
    view.close()
    window_close_input()
    CloseWindow()
}
