mode gui

import("std/sys")
import("editor")
import("tiled_init")

BASE_VERSION := "0.0.1-"

get_version := macro() returns shallow Str {
    mut hash : Str = ""
    status := run_cmd(hash, "git", "rev-parse", "--short", "HEAD")
    if status != 0 { panic("cannot derive the Tiled version from git") }
    return format(BASE_VERSION, hash.replace("\n", ""))
}

VERSION := get_version()

main := proc(args: ..Str) {
    if args.len() == 1 {
        ref arg : Str = args[0]
        if arg == "-v" || arg == "--version" {
            println(VERSION)
            return
        }
    }
    home := get_env("HOME")
    if home.len() > 0 {
        path := format(home, "/.tiled/init.til")
        if File.exists(path) {
            println("Loading ", path)
            failure := tiled_load_init(path)
            if failure.is_some() { err := failure.unwrap(); println(err.to_str()); exit(1) }
            config := tiled_startup_config()
            start_editor(config, ..args)
            return
        }
    }
    println("No ~/.tiled/init.til file found; using defaults.")
    config := tiled_startup_config()
    start_editor(config, ..args)
}
