mode gui
import("std/sys")
import("tilminal_app")
import("config_loader")

main := proc(args: ..Str) {
    if args.len() > 1 { panic("usage: tilminal [command]") }
    home := get_env("HOME")
    if home.len() > 0 {
        path := format(home, "/.tilminal.til")
        if File.exists(path) {
            load_user_config("tilminal", "tilminal_app", "TilminalConfig", "start_tilminal", path, ..args)
            return
        }
    }
    start_tilminal(TilminalConfig(), ..args)
}
