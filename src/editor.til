mode lib

import("std/sys")
import("editor_model")
import("window_input")
import("window_layout")
import("editor_buffers")
import("editor_exit")
import("editor_terminal")
import("editor_commands")
import("session_window")

link_c("editor_save.c")
editor_write_file := ext_proc(path: I8, text: I8, shallow length: UPtr) returns shallow I32 {}
editor_write_error := ext_proc(shallow error: I32) returns ref I8 {}

realpath_str := ext_proc(path: Str) returns Str {}

TiledConfig := struct {
    width : I32 = 800
    height : I32 = 600
    maximized := false
    tile_left := true
    initial_file := ""
    scratch_text := ""
    font_path := ""
    font_size : I32 = 28
    commands := EditorCommands.new()
    session := SessionConfig()
}

editor_font_path := proc(config: TiledConfig) returns Str {
    if config.font_path.len() > 0 { return config.font_path.clone() }
    query := Cmd.new("fc-match", "--format=%{file}", "monospace")
    query.capture_out()
    if query.run() != 0 {
        panic("could not resolve the monospace font; install fontconfig or set config.font_path")
    }
    path := query.out()
    if path.len() == 0 { panic("fontconfig found no monospace font") }
    return path
}

editor_text_width := func(font: Font, text: Str, size: I32) returns I32 {
    terminated := text.clone()
    return MeasureTextEx(font, terminated.c_str, size.to_f32(), 0).x.to_i64().to_i32()
}

editor_draw_text := proc(font: Font, text: Str, x: I32, y: I32, size: I32, color: Color) {
    DrawTextEx(font, text.c_str, Vector2(x = x.to_f32(), y = y.to_f32()),
               size.to_f32(), 0, color)
}

editor_file_path := proc(path: Str) returns Str {
    resolved := realpath_str(path)
    if resolved.len() == 0 { panic("cannot open file: ", path) }
    return resolved
}

editor_save_buffer := proc(mut editor: EditorState, id: USize, mut message: Str) returns Bool {
    ref mut buffer : EditorBuffer = editor.buffers[id]
    if buffer.terminal >= 0 { message = "Terminal buffers cannot be saved as text"; return false }
    mut path := buffer.filename.clone()
    if path.len() == 0 {
        path = save_file_dialog("Save file", "")
        if path.len() == 0 {
            message = "Save cancelled; still editing"
            return false
        }
    }
    error := editor_write_file(path.c_str, buffer.text.c_str, buffer.text.len().to_uptr())
    if error != 0 {
        ref detail : I8 = editor_write_error(error)
        message = format("Save failed: ", Str.from_c_str(detail), " - ", path)
        return false
    }
    resolved := realpath_str(path)
    if resolved.len() > 0 { path = resolved.clone() }
    buffer.filename = path
    buffer.dirty = false
    buffer.disk_text = buffer.text.clone()
    buffer.label = ""; buffer.recovery_note = ""; buffer.restored_terminal = false
    message = "Saved!"
    return true
}

editor_open := proc(mut editor: EditorState) returns Bool {
    selected := open_file_dialog("Open file", "")
    if selected.len() == 0 { return false }
    path := editor_file_path(selected)
    editor.show_buffer(path, File.readfile(path))
    return true
}

editor_key_owner := func(editor: EditorState, prompting: Bool) returns Str {
    current := editor.nodes[editor.focused].view.buffer
    mut context := "text"
    if editor.buffers[current].terminal >= 0 { context = "terminal" }
    if prompting { context = "minibuffer" }
    return format(editor.focused.to_str(), ":", current.to_str(), ":", context)
}

editor_clipboard := proc(mut editor: EditorState, command: Str) returns Bool {
    ref mut view : EditorView = editor.nodes[editor.focused].view
    if command == "set-mark" {
        view.mark = view.cursor; view.mark_active = true; view.mark_explicit = true; return true
    }
    copy := command == "copy"
    cut := command == "cut"
    if copy || cut {
        text := editor.selected_text()
        if text.len() > 0 { SetClipboardText(text.c_str) }
        if cut { editor.cut_selection() } else { view.clear_mark() }
        return true
    }
    if command == "paste" {
        ref raw : I8 = GetClipboardText()
        if !is_null(raw) { editor.insert(Str.from_c_str(raw).replace("\r\n", "\n").replace("\r", "\n")) }
        return true
    }
    return false
}

editor_mouse_text := proc(mut editor: EditorState, font: Font, size: I32, line_h: I32) {
    mouse := GetMousePosition()
    for index : USize in editor.views() {
        ref mut node : EditorNode = editor.nodes[index]
        ref mut view : EditorView = node.view
        ref buffer : EditorBuffer = editor.buffers[view.buffer]
        if buffer.terminal >= 0 { continue }
        rect := node.rect.clone()
        inside := mouse.x >= rect.x.to_f32() && mouse.x < (rect.x + rect.width).to_f32() &&
            mouse.y >= rect.y.to_f32() && mouse.y < (rect.y + rect.height - line_h - 8).to_f32()
        if !view.dragging && !(inside && IsMouseButtonPressed(0)) { continue }
        lines := buffer.text.split("\n")
        gutter := editor_text_width(font, lines.len().to_str(), size) + 20
        row := terminal_bound(((mouse.y.to_i64() - rect.y.cast(I64) - 8) / line_h.cast(I64)) + view.scroll_y.cast(I64), 0, lines.len().to_i64() - 1)
        start := text_row_start(buffer.text, row.to_i32())
        end := text_line_end(buffer.text, start)
        px := mouse.x.to_i64().to_i32() - rect.x - gutter + view.scroll_x
        mut pos := start
        while pos < end {
            next := text_next(buffer.text, pos)
            a := editor_text_width(font, buffer.text.substr(start, pos - start), size)
            b := editor_text_width(font, buffer.text.substr(start, next - start), size)
            if px < (a + b) / 2 { break }
            pos = next
        }
        if inside && IsMouseButtonPressed(0) {
            view.mark = pos; view.mark_active = true; view.mark_explicit = false; view.dragging = true
        }
        view.cursor = pos
        if !IsMouseButtonDown(0) { view.dragging = false }
    }
}

editor_draw_view := proc(mut editor: EditorState, index: USize, font: Font, size: I32, line_h: I32) {
    ref mut node : EditorNode = editor.nodes[index]
    ref mut view : EditorView = node.view
    ref buffer : EditorBuffer = editor.buffers[view.buffer]
    rect := node.rect.clone()
    if rect.width <= 0 || rect.height <= 0 { return }
    DrawRectangle(rect.x, rect.y, rect.width, rect.height, Color(r = 30, g = 30, b = 40, a = 255))
    active := index == editor.focused
    mode_h := line_h + 8
    mut text_h := rect.height - mode_h
    if text_h < 0 { text_h = 0 }
    mut visible := (text_h - 8) / line_h
    if visible < 1 { visible = 1 }
    lines := buffer.text.split("\n")
    cursor_row := text_row(buffer.text, view.cursor)
    start := text_line_start(buffer.text, view.cursor)
    column := view.cursor - start
    before_cursor := buffer.text.substr(start, column).clone()
    cursor_px := editor_text_width(font, before_cursor, size)
    gutter := editor_text_width(font, lines.len().to_str(), size) + 20
    mut text_w := rect.width - gutter - 8
    if text_w < 1 { text_w = 1 }

    if cursor_row < view.scroll_y { view.scroll_y = cursor_row }
    if cursor_row >= view.scroll_y + visible { view.scroll_y = cursor_row - visible + 1 }
    if cursor_px < view.scroll_x { view.scroll_x = cursor_px }
    if cursor_px >= view.scroll_x + text_w - 2 { view.scroll_x = cursor_px - text_w + 2 }
    if view.scroll_x < 0 { view.scroll_x = 0 }

    // Gutter and text have separate clips, so long/scrolled lines cannot bleed
    // into a sibling view or cover their own line numbers.
    BeginScissorMode(rect.x, rect.y, rect.width, text_h)
    mut row : I32 = 0
    while row < visible {
        line_index := view.scroll_y + row
        if line_index < lines.len().to_i32() {
            number := (line_index + 1).to_str()
            editor_draw_text(font, number, rect.x + gutter - editor_text_width(font, number, size) - 10,
                rect.y + 8 + row * line_h, size, Color(r = 110, g = 110, b = 130, a = 255))
        }
        row = row + 1
    }
    EndScissorMode()

    if rect.width > gutter {
        BeginScissorMode(rect.x + gutter, rect.y, rect.width - gutter, text_h)
        row = 0
        while row < visible {
            line_index := view.scroll_y + row
            if line_index < lines.len().to_i32() {
                ref line : Str = lines[line_index.to_usize()]
                y := rect.y + 8 + row * line_h
                if view.selected() {
                    line_start := text_row_start(buffer.text, line_index)
                    lo := view.selection_start(); hi := view.selection_end()
                    if hi > line_start && lo <= line_start + line.len() {
                        a := terminal_bound(lo.to_i64() - line_start.to_i64(), 0, line.len().to_i64()).to_usize()
                        b := terminal_bound(hi.to_i64() - line_start.to_i64(), 0, line.len().to_i64()).to_usize()
                        x1 := editor_text_width(font, line.substr(0, a), size)
                        mut x2 := editor_text_width(font, line.substr(0, b), size)
                        if hi > line_start + line.len() { x2 = x2 + 8 }
                        DrawRectangle(rect.x + gutter - view.scroll_x + x1, y, x2 - x1, line_h, Color(r = 55, g = 85, b = 125, a = 255))
                    }
                }
                editor_draw_text(font, line, rect.x + gutter - view.scroll_x, y,
                    size, Color(r = 220, g = 220, b = 220, a = 255))
                if line_index == cursor_row {
                    mut color := Color(r = 100, g = 100, b = 120, a = 255)
                    if active { color = Color(r = 255, g = 200, b = 0, a = 255) }
                    DrawRectangle(rect.x + gutter + cursor_px - view.scroll_x, y, 2, line_h, color)
                }
            }
            row = row + 1
        }
        EndScissorMode()
    }

    sy := rect.y + text_h
    BeginScissorMode(rect.x, rect.y, rect.width, rect.height)
    mut background := Color(r = 38, g = 38, b = 52, a = 255)
    if active { background = Color(r = 60, g = 60, b = 85, a = 255) }
    DrawRectangle(rect.x, sy, rect.width, mode_h, background)
    if active { DrawRectangle(rect.x, sy, rect.width, 2, Color(r = 255, g = 200, b = 0, a = 255)) }
    EndScissorMode()
    mut name := editor_buffer_name(buffer)
    if buffer.recovery_note.len() > 0 { name = format(name, " [", buffer.recovery_note, "]") }
    if buffer.dirty { name = format(name, " *") }
    position := format("Ln ", (cursor_row + 1).to_str(), " Col ", (column + 1).to_str())
    position_w := editor_text_width(font, position, size)
    mut name_w := rect.width - 16
    if rect.width > position_w + 100 { name_w = rect.width - position_w - 32 }
    if name_w > 0 {
        BeginScissorMode(rect.x + 8, sy, name_w, rect.height - text_h)
        editor_draw_text(font, name, rect.x + 8, sy + 4, size, Color(r = 220, g = 220, b = 220, a = 255))
        EndScissorMode()
    }
    if rect.width > position_w + 100 {
        BeginScissorMode(rect.x, sy, rect.width, rect.height - text_h)
        editor_draw_text(font, position, rect.x + rect.width - position_w - 8, sy + 4,
            size, Color(r = 180, g = 180, b = 180, a = 255))
        EndScissorMode()
    }
}

editor_draw_terminal := proc(mut terminals: EditorTerminals, editor: EditorState, index: USize,
                            font: Font, size: I32, line_h: I32, input_active: Bool) {
    ref node : EditorNode = editor.nodes[index]
    ref buffer : EditorBuffer = editor.buffers[node.view.buffer]
    ref rect : EditorRect = node.rect
    if rect.width <= 0 || rect.height <= 0 { return }
    ref mut slot : EditorTerminal = terminals.slots[buffer.terminal.to_usize()]
    mut body_h := rect.height - line_h - 8
    if body_h < 0 { body_h = 0 }
    active := index == editor.focused
    DrawRectangle(rect.x, rect.y, rect.width, rect.height, Color(r = 16, g = 18, b = 24, a = 255))
    slot.view.draw_scrolled(slot.terminal.screen, rect.x.cast(I64), rect.y.cast(I64),
        rect.width.cast(I64), body_h.cast(I64), active && input_active, slot.terminal.ended,
        node.view.terminal_viewport.offset, node.view.terminal_viewport.selection)
    sy := rect.y + body_h
    mut background := Color(r = 38, g = 38, b = 52, a = 255)
    if active { background = Color(r = 60, g = 60, b = 85, a = 255) }
    BeginScissorMode(rect.x, sy, rect.width, rect.height - body_h)
    DrawRectangle(rect.x, sy, rect.width, rect.height - body_h, background)
    if active { DrawRectangle(rect.x, sy, rect.width, 2, Color(r = 255, g = 200, b = 0, a = 255)) }
    mut state := "running"
    if slot.terminal.ended { state = format("exit ", buffer.terminal_status.to_str()) }
    if node.view.terminal_viewport.offset > 0 { state = format(state, "; scrollback ", node.view.terminal_viewport.offset.to_str()) }
    editor_draw_text(font, format(buffer.terminal_name, " [", state, "]"), rect.x + 8, sy + 4, size,
        Color(r = 220, g = 220, b = 220, a = 255))
    EndScissorMode()
}

editor_tail_text := func(font: Font, text: Str, size: I32, width: I32) returns Str {
    if editor_text_width(font, text, size) <= width { return text.clone() }
    mut first : USize = 0
    while first < text.len() {
        shortened := format("...", text.substr(first, text.len() - first))
        if editor_text_width(font, shortened, size) <= width { return shortened }
        first++
    }
    return "..."
}

editor_draw_minibuffer := proc(mini: Minibuffer, font: Font, size: I32, line_h: I32,
                              width: I32, height: I32, footer_h: I32) {
    matches := mini.matches()
    mut rows := (height - footer_h) / line_h - 1
    if rows > 8 { rows = 8 }
    if rows < 0 { rows = 0 }
    if rows > matches.len().to_i32() { rows = matches.len().to_i32() }
    panel_y := height - footer_h - (rows + 1) * line_h
    DrawRectangle(0, panel_y, width, height - panel_y, Color(r = 24, g = 28, b = 42, a = 255))
    DrawRectangle(0, panel_y, width, 2, Color(r = 110, g = 130, b = 180, a = 255))
    mut help := "Enter OK  Tab complete  Up/Down  C-g/Esc"
    if mini.choices.len() == 0 { help = "Type yes to discard, no or C-g to cancel" }
    else if matches.len() == 0 { help = "No matching buffer - edit the name or C-g to cancel" }
    else { help = format((mini.selected + 1).to_str(), "/", matches.len().to_str(), "  ", help) }
    if mini.help.len() > 0 { help = mini.help.clone() }
    if mini.hint.len() > 0 { help = mini.hint.clone() }
    BeginScissorMode(8, panel_y, width - 16, line_h)
    editor_draw_text(font, help, 8, panel_y + 4, size, Color(r = 155, g = 170, b = 200, a = 255))
    EndScissorMode()
    if rows > 0 {
        first := (mini.selected / rows.to_usize()) * rows.to_usize()
        mut row : I32 = 0
        while row < rows {
            index := first + row.to_usize()
            if index >= matches.len() { break }
            choice := mini.choices[matches[index]].clone()
            y := panel_y + (row + 1) * line_h
            if index == mini.selected {
                DrawRectangle(0, y, width, line_h, Color(r = 55, g = 65, b = 95, a = 255))
            }
            marker_w := editor_text_width(font, choice.marker, size)
            name_w := width / 2 - marker_w - 24
            BeginScissorMode(8, y, width / 2 - 16, line_h)
            editor_draw_text(font, format(choice.marker, editor_tail_text(font, choice.name, size, name_w)), 8, y + 2, size,
                Color(r = 225, g = 225, b = 235, a = 255))
            EndScissorMode()
            BeginScissorMode(width / 2, y, width / 2 - 8, line_h)
            editor_draw_text(font, editor_tail_text(font, choice.detail, size, width / 2 - 16),
                width / 2, y + 2, size, Color(r = 155, g = 170, b = 200, a = 255))
            EndScissorMode()
            row = row + 1
        }
    }
    before := format(mini.label, mini.input.substr(0, mini.cursor))
    point := editor_text_width(font, before, size)
    mut scroll : I32 = 0
    if point > width - 24 { scroll = point - width + 24 }
    y := height - footer_h
    mut text_x : I32 = 8
    text_x = text_x - scroll
    BeginScissorMode(8, y, width - 16, footer_h)
    editor_draw_text(font, format(mini.label, mini.input), text_x, y + 4, size,
        Color(r = 240, g = 230, b = 190, a = 255))
    DrawRectangle(text_x + point, y + 4, 2, line_h, Color(r = 255, g = 200, b = 0, a = 255))
    EndScissorMode()
}

start_editor := proc(config: TiledConfig, args: ..Str) {
    options := SessionArgs.parse(..args)
    mut session := SessionStore.new("tiled", config.session, options)
    font_size := config.font_size
    if font_size <= 0 { panic("config.font_size must be positive") }
    font_path := editor_font_path(config)
    if !File.is_file(font_path) { panic("font file not found: ", font_path) }
    mut editor := EditorState.new("", config.scratch_text)
    mut frame := SessionFrame()
    restored := editor_restore_session(session, editor, frame)
    mut filename := options.operand.clone()
    if !options.has_operand && !restored { filename = config.initial_file.clone() }
    if filename.len() > 0 {
        filename = editor_file_path(filename)
        if !restored { editor = EditorState.new(filename, File.readfile(filename)) }
        else { editor.show_buffer(filename, File.readfile(filename)) }
    }
    mut status_msg := session.notice.clone()
    mut status_timer : I64 = 10000
    mut key_state := KeyState()
    mut prompt := EditorBufferPrompt()
    mut exit_prompt := EditorExitPrompt()
    exit_prompt.keep_allowed = session.enabled
    mut terminals := EditorTerminals()

    SetConfigFlags(FLAG_WINDOW_RESIZABLE.cast(U32))
    InitWindow(config.width, config.height, "Tiled".c_str)
    window_init_input()
    // Escape cancels an active prompt; outside prompts it retains quit behavior.
    SetExitKey(0)
    font := LoadFontEx(font_path.c_str, font_size, Option(ref I32).None, 0)
    if !IsFontValid(font) || font.texture.id == GetFontDefault().texture.id {
        panic("could not load font: ", font_path)
    }
    SetTextureFilter(font.texture, TEXTURE_FILTER_BILINEAR)
    line_h := MeasureTextEx(font, "Mg".c_str, font_size.to_f32(), 0).y.to_i64().to_i32() + 6
    footer_h := line_h + 8
    min_view_h := line_h * 2 + 16
    min_view_w := font_size * 8 + 40
    SetWindowMinSize(400, min_view_h + footer_h)
    if restored { session_restore_window(frame) }
    else if config.maximized {
        MaximizeWindow()
    } else if config.tile_left {
        mut x : I32 = 0
        mut y : I32 = 0
        mut width : I32 = 0
        mut height : I32 = 0
        mut left : I32 = 0
        mut top : I32 = 0
        mut right : I32 = 0
        mut bottom : I32 = 0
        window_placement_data(GetCurrentMonitor(), x, y, width, height, left, top, right, bottom)
        placement := window_left_placement(x, y, width, height, left, top, right, bottom)
        SetWindowSize(placement.width, placement.height)
        SetWindowPosition(placement.x, placement.y)
    }
    SetTargetFPS(60)
    mut checkpoint_at := GetTime()
    mut checkpoint_now := false

    while true {
        if status_timer > 0 {
            status_timer = status_timer - (GetFrameTime() * 1000).to_i64()
            if status_timer <= 0 { status_msg = "" }
        }
        width := GetScreenWidth()
        height := GetScreenHeight()
        area := EditorRect(width = width, height = height - footer_h)
        editor.arrange(0, area)
        if !prompt.mini.active && !exit_prompt.mini.active && IsMouseButtonPressed(0) {
            mouse := GetMousePosition()
            for index : USize in editor.views() {
                ref rect : EditorRect = editor.nodes[index].rect
                if mouse.x >= rect.x.to_f32() && mouse.x < (rect.x + rect.width).to_f32() &&
                   mouse.y >= rect.y.to_f32() && mouse.y < (rect.y + rect.height).to_f32() {
                    editor.focused = index
                }
            }
        }

        terminals.update(editor, line_h + 8)
        if session.enabled && (checkpoint_now || GetTime() >= checkpoint_at) {
            checkpoint_at = GetTime() + config.session.interval_ms.to_f64() / 1000.0
            checkpoint_now = false
            data := EditorCheckpoint.encode(editor, session_window_frame(), terminals.snapshot(editor), Vec(USize).new())
            if !session.save(data) { status_msg = session.notice.clone(); status_timer = 10000; println(status_msg) }
        }
        had_prefix := key_state.pending.len() > 0
        key_state.context(editor_key_owner(editor, prompt.mini.active || exit_prompt.mini.active))
        if had_prefix && key_state.pending.len() == 0 { status_msg = ""; status_timer = 0 }
        if !prompt.mini.active && !exit_prompt.mini.active && key_state.pending.len() == 0 {
            terminals.mouse(editor, line_h + 8)
            editor_mouse_text(editor, font, font_size, line_h)
        }
        wheel := GetMouseWheelMove()
        if wheel != 0 && !prompt.mini.active && !exit_prompt.mini.active && key_state.pending.len() == 0 {
            mouse := GetMousePosition()
            terminals.wheel(editor, (wheel * 3).to_i64(), mouse.x, mouse.y, line_h + 8)
        }
        mut quit := false
        mut mods : I32 = 0
        mut action : I32 = 0
        mut key := window_next_event(mods, action)
        while key > 0 {
            mut save := false
            mut open := false
            current := editor.nodes[editor.focused].view.buffer
            terminal := editor.buffers[current].terminal
            prompting := prompt.mini.active || exit_prompt.mini.active
            mut context := "text"
            mut selected := editor.nodes[editor.focused].view.selected()
            mut primary := true
            if terminal >= 0 {
                context = "terminal"
                selected = editor.nodes[editor.focused].view.terminal_viewport.selection.active()
                primary = !terminals.slots[terminal.to_usize()].terminal.screen.alternate_active
            }
            if prompting { context = "minibuffer"; selected = false }
            key_state.context(editor_key_owner(editor, prompting))
            dispatch := key_state.event(config.commands.keys, context, selected, primary, key, mods, action)
            if action == 4 {
                quit = true
            } else if dispatch.kind == 2 {
                status_msg = "Prefix..."; status_timer = 0
            } else if dispatch.kind == 4 {
                status_msg = "Undefined key sequence"; status_timer = 2000
            } else if dispatch.kind == 0 {
                if terminal >= 0 && !prompting {
                    terminals.forward(editor, terminal, key, mods, action)
                } else if action == 3 && mods.band(6) == 0 && key >= 32 && key < 127 {
                    typed := Str.from_byte(key.cast(I64).to_u8())
                    if exit_prompt.mini.active { exit_prompt.mini.insert(typed) }
                    else if prompt.mini.active { prompt.mini.insert(typed) }
                    else { editor.insert(typed) }
                }
            } else if dispatch.kind == 1 {
                command := dispatch.command
                status_msg = ""; status_timer = 2000
                if config.commands.invoke(command, editor) {
                    // Registered Til callbacks take precedence over built-ins.
                } else if command == "cancel" {
                    editor.nodes[editor.focused].view.clear_mark()
                    key_state.cancel()
                    prompt.cancel()
                    exit_prompt.cancel()
                    status_msg = "Cancelled"
                } else if command == "ignore" {
                } else if command == "quit" { quit = true }
                else if prompting {
                    if command == "accept" && exit_prompt.mini.active {
                        selected := exit_prompt.mini.choice()
                        if selected < 0 {
                            exit_prompt.mini.hint = "Choose an exit action from the list"
                        } else {
                            decision := exit_prompt.mini.choices[selected.to_usize()].id
                            if decision == 0 {
                                exit_prompt.cancel()
                                status_msg = "Exit cancelled"
                            } else if decision == 2 {
                                exit_prompt.discarded.push(own exit_prompt.pending[exit_prompt.position].clone())
                                exit_prompt.advance(editor)
                            } else if decision == 3 {
                                exit_prompt.kept = true
                                exit_prompt.advance(editor)
                            } else {
                                id := exit_prompt.pending[exit_prompt.position].clone()
                                if editor_save_buffer(editor, id, status_msg) {
                                    exit_prompt.advance(editor)
                                } else { exit_prompt.cancel() }
                            }
                            status_timer = 4000
                        }
                    } else if command == "accept" {
                        status_msg = prompt.accept(editor)
                    } else {
                        mapped := command_key(command)
                        if mapped == 0 { status_msg = format("Unavailable in minibuffer: ", command) }
                        else if exit_prompt.mini.active { exit_prompt.mini.key(mapped, mods.band(1) != 0) }
                        else { prompt.mini.key(mapped, mods.band(1) != 0) }
                    }
                } else if command == "save-buffer" { save = true }
                else if command == "session-save" { checkpoint_now = true }
                else if command == "find-file" { open = true }
                else if command == "switch-buffer" || command == "list-buffers" || command == "kill-buffer" {
                    mut kind := BufferPromptKind.Switch
                    if command == "list-buffers" { kind = BufferPromptKind.List }
                    if command == "kill-buffer" { kind = BufferPromptKind.Kill }
                    prompt.begin(editor, kind)
                } else if command == "new-terminal" {
                    terminals.spawn(editor, font_path, status_msg)
                } else if command == "split-below" || command == "split-right" {
                    if !editor.split(command == "split-right", min_view_w, min_view_h) {
                        status_msg = "View too small to split"
                    }
                } else if command == "other-view" {
                    editor.next_view()
                } else if command == "close-view" {
                    if !editor.close_view() { status_msg = "Cannot close the only view" }
                } else if command == "only-view" {
                    editor.only_view()
                } else if terminal >= 0 {
                    if command == "forward-key" { terminals.forward(editor, terminal, key, mods, action) }
                    else if command == "send-prefix" { terminals.forward(editor, terminal, 88, 2, 1) }
                    else if !terminals.command(editor, terminal, command, line_h + 8) { status_msg = format("Unavailable in terminal: ", command) }
                } else if editor_clipboard(editor, command) {
                } else if command == "newline" { editor.insert("\n") }
                else if command == "backspace" { editor.backspace() }
                else if command == "delete" { editor.delete_forward() }
                else {
                    mapped := command_key(command)
                    if mapped >= 262 && mapped <= 269 { editor.select_move(mapped, mods.band(1) != 0) }
                    else if command != "forward-key" { status_msg = format("Unavailable in text: ", command) }
                }
                editor.arrange(0, area)
            }
            if quit {
                key_state.cancel()
                prompt.cancel()
                exit_prompt.begin(editor)
                quit = false
            }
            if exit_prompt.ready { break }
            if save {
                id := editor.nodes[editor.focused].view.buffer
                editor_save_buffer(editor, id, status_msg)
                status_timer = 2000
            }
            if open && editor_open(editor) {
                status_msg = "Opened!"
                status_timer = 2000
            }
            key = window_next_event(mods, action)
        }
        // The ordered bridge owns keyboard dispatch. Drain raylib's copies.
        window_drain_input()
        if exit_prompt.ready {
            if session.enabled {
                data := EditorCheckpoint.encode(editor, session_window_frame(), terminals.snapshot(editor), exit_prompt.discarded)
                if !session.seal(data) {
                    println(session.notice)
                    if exit_prompt.kept {
                        exit_prompt.cancel(); status_msg = format(session.notice, "; still open. Save/discard files or retry Keep."); status_timer = 10000
                        continue
                    }
                }
            }
            break
        }

        BeginDrawing()
        ClearBackground(Color(r = 70, g = 70, b = 90, a = 255))
        for index : USize in editor.views() {
            id := editor.nodes[index].view.buffer
            if editor.buffers[id].terminal >= 0 {
                editor_draw_terminal(terminals, editor, index, font, font_size, line_h,
                    !prompt.mini.active && !exit_prompt.mini.active)
            } else { editor_draw_view(editor, index, font, font_size, line_h) }
        }
        active_buffer := editor.nodes[editor.focused].view.buffer
        window_title := format("Tiled - ", editor_buffer_name(editor.buffers[active_buffer]))
        SetWindowTitle(window_title.c_str)
        DrawRectangle(0, height - footer_h, width, footer_h, Color(r = 38, g = 38, b = 52, a = 255))
        BeginScissorMode(8, height - footer_h, width - 16, footer_h)
        mut message := "C-x t Terminal  C-x b Buffers  C-x 2/3 Split"
        if status_msg.len() > 0 { message = status_msg.clone() }
        editor_draw_text(font, message, 8, height - footer_h + 4, font_size,
            Color(r = 160, g = 160, b = 180, a = 255))
        EndScissorMode()
        if prompt.mini.active { editor_draw_minibuffer(prompt.mini, font, font_size, line_h, width, height, footer_h) }
        if exit_prompt.mini.active { editor_draw_minibuffer(exit_prompt.mini, font, font_size, line_h, width, height, footer_h) }
        EndDrawing()
    }
    terminals.close()
    UnloadFont(font)
    window_close_input()
    CloseWindow()
}
