mode cli
import("../src/editor_model")

main := proc() {
    mut e := EditorState.new("", "a界é\nsecond")
    e.select_move(262, false)
    e.select_move(262, true)
    assert(e.selected_text() == "界")
    e.cut_selection()
    assert(e.buffers[0].text == "aé\nsecond")
    e.insert("界")
    assert(e.buffers[0].text == "a界é\nsecond")
    e.backspace()
    assert(e.buffers[0].text == "aé\nsecond")
    e.select_move(269, true)
    assert(e.selected_text() == "é")
    e.insert("replacement")
    assert(e.buffers[0].text == "areplacement\nsecond")
    e.select_move(268, false)
    e.select_move(269, true)
    e.delete_forward()
    assert(e.buffers[0].text == "\nsecond")
    assert(!e.nodes[e.focused].view.selected())
    e.insert("first")
    e.select_move(268, false)
    ref mut v : EditorView = e.nodes[e.focused].view
    v.mark = v.cursor; v.mark_active = true; v.mark_explicit = true
    e.select_move(269, false)
    assert(e.selected_text() == "first")
    e.nodes[e.focused].view.clear_mark()
    assert(e.selected_text() == "")
    mut reverse := EditorState.new("", "EDIT_ME")
    reverse.move_cursor(269)
    reverse.select_move(268, true)
    assert(reverse.selected_text() == "EDIT_ME")
    reverse.cut_selection()
    assert(reverse.buffers[0].text == "" && reverse.nodes[0].view.cursor == 0)
    reverse.insert("EDIT_ME")
    assert(reverse.nodes[0].view.cursor == 7 && reverse.buffers[0].text == "EDIT_ME")
    reverse.select_move(268, true)
    reverse.cut_selection()
    assert(reverse.buffers[0].text == "" && reverse.nodes[0].view.cursor == 0)
    reverse.insert("EDIT_ME")
    reverse.select_move(268, false)
    assert(reverse.nodes[0].view.cursor == 0)
    println("PASS: editor regions, cut, replacement, mark movement and UTF-8 boundaries")
}
