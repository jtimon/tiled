mode cli
import("../gen/terminal_api")

main := proc() {
    mut s := TerminalScreen.new(5, 3)
    s.feed("abcdef\r\nXYZ")
    mut v := TerminalViewport.new()
    v.selection.begin(s, 0, 0, 0); v.selection.extend(s, 3, 2, 0)
    assert(v.selection.text(s) == "abcdef\nXYZ")
    mut padding := TerminalScreen.new(5, 2)
    padding.feed("abcd界")
    mut padded := TerminalSelection.new()
    padded.begin(padding, 0, 0, 0); padded.extend(padding, 2, 1, 0)
    assert(padded.text(padding) == "abcd界")
    mut history := TerminalScreen.new(5, 2)
    history.feed("abcdefghijkl")
    padded.begin(history, 0, 0, 1); padded.extend(history, 2, 1, 0)
    assert(padded.text(history) == "abcdefghijkl")
    blank := TerminalScreen.new(5, 2)
    padded.begin(blank, 0, 0, 0); padded.extend(blank, 0, 1, 0)
    assert(padded.text(blank) == "\n")
    assert(v.clipboard_command(s, 67, 2, 1) == 1)
    v.selection.clear()
    assert(v.clipboard_command(s, 67, 2, 1) == 0) // next Ctrl-C reaches the child
    assert(v.clipboard_command(s, 67, 3, 1) == 1)
    assert(v.clipboard_command(s, 86, 2, 1) == 0) // plain Ctrl-V is still quoted insert
    assert(v.clipboard_command(s, 86, 3, 1) == 2)
    assert(v.clipboard_command(s, 89, 2, 1) == 2)
    v.selection.begin(s, 3, 2, 0); v.selection.extend(s, 0, 0, 0)
    assert(v.selection.text(s) == "abcdef\nXYZ")
    assert(v.clipboard_command(s, 87, 4, 1) == 1)
    assert(v.clipboard_command(s, 119, 4, 3) == 3) // Alt text must not leak after M-w
    assert(v.clipboard_command(s, 71, 2, 1) == 3 && !v.selection.active())
    assert(v.clipboard_command(s, 71, 2, 1) == 0)

    mut wide := TerminalScreen.new(5, 2)
    wide.feed("界éxy\r\nnext\r\nlast")
    v.selection.begin(wide, 1, 0, 1); v.selection.extend(wide, 3, 0, 1)
    assert(v.selection.text(wide) == "界é")
    assert(v.selection.contains(wide, 0, 0, 1) && v.selection.contains(wide, 1, 0, 1))
    mut other := v.clone()
    other.selection.clear()
    assert(v.selection.active() && !other.selection.active())
    wide.feed("!"); v.sync(wide)
    assert(!v.selection.active())
    v.selection.begin(wide, 0, 0, 1); v.selection.extend(wide, 3, 0, 1)
    wide.resize(4, 2); v.sync(wide)
    assert(!v.selection.active())
    v.selection.begin(wide, 0, 0, 0); v.selection.extend(wide, 3, 0, 0)
    wide.feed(terminal_escape("[?1049h")); v.sync(wide)
    assert(!v.selection.active())
    assert(terminal_paste(s, "a\r\nb\nc") == "a\rb\rc")
    s.feed(terminal_escape("[?2004h"))
    assert(s.bracketed_paste)
    assert(terminal_paste(s, "界\r\nx") == format(terminal_escape("[200~"), "界\nx", terminal_escape("[201~")))
    assert(terminal_paste(s, "") == "")
    assert(terminal_paste(s, format("a", terminal_escape("[201~"), Str.from_byte(0), "b")) ==
        format(terminal_escape("[200~"), "a[201~b", terminal_escape("[201~")))
    s.feed(terminal_escape("[?2004l")); assert(!s.bracketed_paste)
    s.feed(terminal_escape("[?2004h")); s.feed(terminal_escape("c")); assert(!s.bracketed_paste)
    println("PASS: terminal selection, soft wraps, Unicode, clipboard routing, invalidation and bracketed paste")
}
