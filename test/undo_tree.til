mode cli
import("../src/undo_prompt")
import("../src/editor_commands")
import("../src/command_discovery")
import("../src/editor_session")

compound := func(mut e: EditorState) { e.insert("a"); e.insert("b") }

main := proc() {
    mut e := EditorState.new("", "")
    assert(!e.undo_edit() && !e.redo_edit())
    e.type_text("a"); e.type_text("界"); e.type_text("b")
    assert(e.buffers[0].undo.nodes.len() == 2)
    assert(e.undo_edit()); assert(e.buffers[0].text == "" && !e.buffers[0].dirty)
    assert(e.redo_edit()); assert(e.buffers[0].text == "a界b" && e.nodes[0].view.cursor == 5)
    e.insert("1"); e.insert("2")
    old_tip := e.buffers[0].undo.current
    assert(e.undo_edit()); assert(e.undo_edit())
    fork := e.buffers[0].undo.current
    e.insert("X")
    new_tip := e.buffers[0].undo.current
    assert(e.undo_edit()); assert(e.buffers[0].undo.nodes[fork].children.len() == 2)
    assert(e.buffers[0].undo.branch(-1)); assert(e.redo_edit()); assert(e.redo_edit())
    assert(e.buffers[0].text == "a界b12")
    e.undo_to(new_tip); assert(e.buffers[0].text == "a界bX")
    e.undo_to(old_tip); assert(e.buffers[0].text == "a界b12")
    e.undo_to(0); assert(e.buffers[0].text == "" && !e.buffers[0].dirty)
    e.undo_to(new_tip); e.mark_saved(0)
    assert(!e.buffers[0].dirty && e.buffers[0].undo.saved == new_tip.to_i64())
    assert(e.undo_edit()); assert(e.buffers[0].dirty)
    assert(e.redo_edit()); assert(!e.buffers[0].dirty)
    e.type_text("!"); assert(e.buffers[0].dirty)
    assert(e.undo_edit()); assert(!e.buffers[0].dirty)
    // Equal content on a different branch is clean too; a missing disk file isn't.
    e.undo_to(fork); e.insert("X"); assert(!e.buffers[0].dirty)
    ref mut buffer : EditorBuffer = e.buffers[0]
    buffer.needs_save = true; buffer.dirty = true
    e.insert("!"); assert(e.undo_edit()); assert(e.buffers[0].dirty)
    e.mark_saved(0); assert(!e.buffers[0].dirty)

    mut groups := EditorState.new("", "")
    groups.type_text("a"); groups.edit_time_ms = 1001; groups.type_text("b")
    assert(groups.undo_edit()); assert(groups.buffers[0].text == "a")
    groups.type_text("c"); groups.move_cursor(268); groups.move_cursor(269); groups.type_text("d")
    assert(groups.undo_edit()); assert(groups.buffers[0].text == "ac")
    groups.begin_edit_command("replace-two-parts")
    groups.insert("first"); groups.move_cursor(268); groups.insert("second")
    groups.end_edit_command()
    assert(groups.undo_edit()); assert(groups.buffers[0].text == "ac")
    assert(groups.nodes[0].view.cursor == 2)
    groups.begin_edit_command("backspace", true); groups.backspace(true); groups.end_edit_command()
    groups.begin_edit_command("backspace", true); groups.backspace(true); groups.end_edit_command()
    assert(groups.buffers[0].text == "")
    assert(groups.undo_edit()); assert(groups.buffers[0].text == "ac")
    groups.move_cursor(268)
    groups.begin_edit_command("delete", true); groups.delete_forward(true); groups.end_edit_command()
    groups.begin_edit_command("delete", true); groups.delete_forward(true); groups.end_edit_command()
    assert(groups.undo_edit()); assert(groups.buffers[0].text == "ac")
    groups.select_move(269, true); groups.insert("UTF-8界")
    assert(groups.undo_edit()); assert(groups.buffers[0].text == "ac" && groups.nodes[0].view.cursor == 2)
    assert(groups.redo_edit()); assert(groups.buffers[0].text == "UTF-8界")
    groups.backspace(); assert(groups.buffers[0].text == "UTF-8")
    assert(groups.undo_edit()); assert(groups.buffers[0].text == "UTF-8界")
    mut cap := EditorState.new("", "")
    for _ in 0..65 { cap.type_text("a") }
    assert(cap.undo_edit()); assert(cap.buffers[0].text.len() == 64)
    assert(cap.undo_edit()); assert(cap.buffers[0].text == "")

    mut shared := EditorState.new("", "abcd")
    shared.arrange(0, EditorRect(width = 1200, height = 800))
    shared.move_cursor(269); assert(shared.split(true, 100, 100))
    left := shared.focused; shared.next_view(); right := shared.focused
    other := shared.add_buffer("other", "")
    shared.switch_buffer(other); shared.next_view(); assert(shared.focused == left)
    shared.move_cursor(268); shared.insert("XY")
    assert(shared.nodes[right].history[0].cursor == 6)
    shared.next_view(); shared.switch_buffer(0)
    assert(shared.nodes[right].view.cursor == 6)
    assert(shared.undo_edit()); assert(shared.buffers[0].text == "abcd")
    assert(shared.nodes[right].view.cursor == 0 && shared.nodes[left].view.cursor == 0)
    assert(shared.redo_edit()); assert(shared.nodes[right].view.cursor == 2)
    shared.type_text("R"); shared.next_view(); shared.type_text("L")
    assert(shared.undo_edit()); assert(shared.buffers[0].text == "XYRabcd")
    assert(shared.undo_edit()); assert(shared.buffers[0].text == "XYabcd")
    shared.begin_edit_command("multi-view-command")
    shared.insert("first"); shared.next_view(); shared.insert("second")
    shared.end_edit_command()
    assert(shared.undo_edit()); assert(shared.buffers[0].text == "XYabcd")
    mut identical := EditorState.new("", "same")
    identical.select_move(269, true); identical.insert("same")
    assert(!identical.nodes[0].view.selected() && identical.nodes[0].view.cursor == 4)
    assert(!identical.buffers[0].dirty && !identical.undo_edit())

    mut prompt := UndoPrompt()
    prompt.begin(e)
    assert(prompt.mini.choices.len() == e.buffers[0].undo.nodes.len())
    current := e.buffers[0].undo.current
    prompt.select(old_tip); prompt.command(e, "cancel", 0, false)
    assert(e.buffers[0].undo.current == current)
    prompt.begin(e); prompt.select(old_tip); prompt.command(e, "left", 263, false)
    assert(prompt.mini.choices[prompt.mini.choice().to_usize()].id == e.buffers[0].undo.nodes[old_tip].parent.to_usize())
    prompt.command(e, "right", 262, false)
    assert(prompt.mini.choices[prompt.mini.choice().to_usize()].id == old_tip)
    prompt.command(e, "accept", 257, false)
    assert(!prompt.mini.active && e.buffers[0].text == "a界b12")
    // Binding and discovery boundaries keep terminal child undo keys untouched.
    mut commands := EditorCommands.new(); mut keys := KeyState()
    assert(keys.event(commands.keys, "text", false, true, 90, 2, 1).command == "undo")
    keys.cancel()
    assert(keys.event(commands.keys, "terminal", false, true, 90, 2, 1).kind == 0)
    mut discovery := CommandDiscovery()
    assert(discovery.available("undo")); discovery.context = "terminal"
    assert(!discovery.available("undo") && !discovery.available("undo-tree-visualize"))
    commands.command("backspace", compound)
    mut custom := EditorState.new("", "")
    custom.begin_edit_command("backspace", true)
    assert(commands.invoke("backspace", custom)); custom.end_edit_command()
    assert(custom.buffers[0].text == "ab")
    assert(custom.undo_edit()); assert(custom.buffers[0].text == "")
    path := format("tmp/undo-recovery-", process_id().to_str())
    File.writefile(path, "baseline")
    mut recovery := EditorState.new(path, "baseline")
    recovery.insert("edit")
    checkpoint := EditorCheckpoint.encode(recovery, SessionFrame(), Vec(SessionTerminalOutput).new(), Vec(USize).new())
    File.remove(path)
    mut missing := EditorCheckpoint.decode(checkpoint)
    assert(missing.recover_files() == 1)
    assert(!missing.editor.undo_edit()) // Restored text starts a fresh history.
    missing.editor.insert("x"); assert(missing.editor.undo_edit())
    assert(missing.editor.buffers[0].dirty && missing.editor.buffers[0].needs_save)
    File.writefile(path, "external change")
    mut conflict := EditorCheckpoint.decode(checkpoint)
    assert(conflict.recover_files() == 1)
    conflict.editor.replace(0, 4, "")
    assert(conflict.editor.buffers[0].text == "baseline" && conflict.editor.buffers[0].dirty)
    conflict.editor.mark_saved(0); assert(!conflict.editor.buffers[0].needs_save)
    File.remove(path)
    println("PASS: branching undo, grouping, UTF-8, saved state, shared/hidden views and tree browser")
}
