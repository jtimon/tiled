mode cli
import("../gen/terminal_api")

main := proc() {
    mut s := TerminalScreen.new(5, 3)
    s.set_history_limit(3)
    s.feed("A\r\nB\r\nC\r\nD\r\nE\r\nF\r\nG")
    assert(s.history_rows() == 3 && s.history_total == 4)
    assert(s.display_cell(0, 0, 3).text == "B")
    assert(s.display_cell(0, 2, 3).text == "D")
    assert(s.display_cell(0, 2, 1).text == "F")
    assert(s.cell_at(0, 0).text == "E")
    mut a := TerminalViewport.new()
    mut b := TerminalViewport.new()
    a.scroll(s, 2)
    assert(a.offset == 2 && b.offset == 0)
    s.feed("\r\nH")
    a.sync(s); b.sync(s)
    assert(a.offset == 3 && b.offset == 0)
    assert(s.display_cell(0, 0, a.offset).text == "C")
    // Eviction clamps the anchor to the oldest available row, including when
    // a hidden view was not synchronized while its session kept pumping.
    s.feed("\r\nI\r\nJ\r\nK\r\nL")
    a.sync(s)
    assert(a.offset == 3 && s.display_cell(0, 0, a.offset).text == "G")
    assert(a.event(s, 267, 1, 1, 3) && a.offset == 1)
    assert(a.event(s, 266, 1, 2, 3) && a.offset == 3)
    assert(!a.event(s, 340, 1, 1, 3) && a.offset == 3)
    assert(!a.event(s, 120, 0, 3, 3) && a.offset == 0)
    a.scroll(s, 1); b.scroll(s, 3)
    assert(!a.event(s, 257, 0, 1, 3) && b.offset == 3)

    mut copy := s.clone()
    copy.clear_history()
    assert(copy.history_rows() == 0 && s.history_rows() == 3)
    s.feed(terminal_escape("[?1049h"))
    s.feed("alt\r\nalt\r\nalt\r\nalt")
    assert(s.history_rows() == 3)
    b.sync(s); b.scroll(s, 99)
    assert(b.offset == 0 && !b.event(s, 266, 1, 1, 3))
    s.feed(terminal_escape("[3J"))
    assert(s.history_rows() == 3)
    s.feed(terminal_escape("[?1049l"))
    assert(s.history_rows() == 3 && s.display_cell(0, 0, 3).text == "G")
    b.scroll(s, 3)
    s.feed(terminal_escape("[?47h")); s.feed(terminal_escape("[?47l"))
    b.sync(s)
    assert(b.offset == 0 && s.history_rows() == 3)

    s.clear_history()
    s.feed(terminal_escape("[2;3r")); s.feed("\r\n\r\n\r\n")
    assert(s.history_rows() == 0)
    s.feed(terminal_escape("[r")); s.feed(terminal_escape("[H")); s.feed(terminal_escape("[M"))
    assert(s.history_rows() == 0) // deleting lines isn't output history
    s.feed(terminal_escape("[2S"))
    assert(s.history_rows() == 2)
    s.feed(terminal_escape("[2J"))
    assert(s.history_rows() == 2)
    s.feed("KEEP")
    s.feed(terminal_escape("[3J"))
    assert(s.history_rows() == 0 && s.cell_at(0, 0).text == "K")

    mut wide := TerminalScreen.new(5, 2)
    wide.feed("abc界\r\né\r\nlast")
    assert(wide.history_rows() == 1 && wide.display_cell(3, 0, 1).span == 2)
    wide.resize(4, 3)
    assert(wide.display_cell(3, 0, 1).text == " " && wide.display_cell(3, 0, 1).span == 1)
    wide.resize(7, 2)
    assert(wide.display_cell(3, 0, 1).text == "界" && wide.display_cell(4, 0, 1).span == 0)
    assert(wide.display_cell(6, 0, 1).text == " " && wide.cell_at(0, 0).text == "é")
    wide.feed("\r\nmore")
    assert(wide.display_cell(0, 0, 1).text == "é")
    a.scroll(wide, 1)
    wide.feed(terminal_escape("c")); a.sync(wide)
    assert(wide.history_rows() == 0 && a.offset == 0)
    wide.set_history_limit(0)
    wide.feed("1\r\n2\r\n3\r\n4")
    assert(wide.history_rows() == 0)
    mut wrapped := TerminalScreen.new(3, 2)
    wrapped.feed(terminal_escape("[31m")); wrapped.feed("abcdef")
    assert(wrapped.history_rows() == 0)
    wrapped.feed("g")
    assert(wrapped.history_rows() == 1 && wrapped.display_cell(0, 0, 1).text == "a")
    assert(wrapped.display_cell(0, 0, 1).style.fg == 1)
    recording := format("界é\r\n", terminal_escape("[32m"), "abc\r\ndef\r\nghi")
    mut whole := TerminalScreen.new(5, 2)
    whole.feed(recording)
    for split in 0..(recording.len() + 1) {
        mut chunked := TerminalScreen.new(5, 2)
        chunked.feed(recording.substr(0, split)); chunked.feed(recording.substr(split, recording.len() - split))
        assert(chunked.history_rows() == whole.history_rows())
        for y in 0..2 {
            for x in 0..5 {
                assert(chunked.display_cell(x, y, 2).text == whole.display_cell(x, y, 2).text)
                assert(chunked.display_cell(x, y, 2).style.fg == whole.display_cell(x, y, 2).style.fg)
            }
        }
    }
    println("PASS: bounded history, eviction, independent anchored views, navigation, resize, Unicode, alternate pages and reset")
}
