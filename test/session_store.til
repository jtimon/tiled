mode cli
import("../src/editor_session")

fixture_store := proc(directory: Str, name: Str) returns SessionStore {
    mut store := SessionStore.new("unused", SessionConfig(enabled = false), SessionArgs())
    store.enabled = true; store.directory = directory.clone(); store.acquire(name)
    return store
}
encode := func(editor: EditorState, discarded: Vec(USize)) returns Str {
    return EditorCheckpoint.encode(editor, SessionFrame(), Vec(SessionTerminalOutput).new(), discarded)
}
main := proc() {
    dir := format(get_cwd_str(), "/tmp/session-store-", process_id().to_str())
    assert(mkdir_p(dir) == 0)
    source := format(dir, "/document.txt")
    File.writefile(source, "original")
    mut editor := EditorState.new(source, "original")
    editor.insert("edit ")
    discarded := Vec(USize).new()
    mut store := fixture_store(dir, "default")
    original_path := store.path.clone()
    first := encode(editor, discarded)
    assert(store.save(first))
    editor.insert("second ")
    assert(store.save(encode(editor, discarded)))
    assert(File.readfile(format(store.path, ".previous")) == first)
    {
        mut second := fixture_store(dir, "default")
        assert(second.name != "default" && !second.restore)
        assert(second.save(first))
        assert(File.readfile(store.path) != first)
    }
    // An interrupted temp write cannot replace the main checkpoint.
    old := File.readfile(store.path)
    assert(mkdir_p(format(store.path, ".tmp")) == 0)
    File.writefile(format(store.path, ".tmp/marker"), "occupied")
    assert(!store.save(first))
    assert(File.readfile(store.path) == old)
    File.remove_tree(format(store.path, ".tmp"))
    File.writefile(source, "external")
    File.writefile(store.path, "truncated checkpoint")
    mut restored := EditorState.new("", "")
    mut frame := SessionFrame()
    assert(editor_restore_session(store, restored, frame))
    assert(restored.buffers[0].text == "edit original" && restored.buffers[0].dirty)
    assert(restored.buffers[0].recovery_note.contains("disk changed"))
    assert(store.notice.contains("previous checkpoint"))
    assert(File.readfile(source) == "external")
    assert(store.save(encode(restored, discarded)))
    assert(File.readfile(format(store.path, ".previous")) == first)
    mut discard := Vec(USize).new(); discard.push(own I64.to_usize(0))
    assert(store.seal(encode(restored, discard)))
    current := File.readfile(store.path)
    assert(current == File.readfile(format(store.path, ".previous")))
    assert(!EditorCheckpoint.decode(current).editor.buffers[0].dirty)
    assert(editor_restore_session(store, restored, frame))
    assert(restored.buffers[0].text == "external" && !restored.buffers[0].dirty)
    File.remove(source)
    assert(editor_restore_session(store, restored, frame))
    assert(restored.buffers[0].text == "original" && restored.buffers[0].dirty)
    assert(restored.buffers[0].recovery_note.contains("missing"))
    File.writefile(store.path, "broken"); File.writefile(format(store.path, ".previous"), "broken backup")
    assert(!editor_restore_session(store, restored, frame))
    assert(store.path != original_path && store.notice.contains("preserved"))
    assert(File.readfile(original_path) == "broken")
    mut disabled := SessionStore.new("unused", SessionConfig(enabled = false), SessionArgs())
    assert(!disabled.save(first) && disabled.path == "")
    println("PASS: checkpoints, writer isolation, failed writes, fallback, changed/missing files and final discard sealing")
}
