mode gui
import("terminal_gui_helpers")
import("../src/editor_session")

XMoveResizeWindow := ext_proc(display: Dynamic, shallow window: UPtr, shallow x: I32, shallow y: I32, shallow width: U32, shallow height: U32) returns shallow I32 {}

tap := proc(display: Dynamic, key: UPtr) { send(display, key, 1); send(display, key, 0); sleep_ms(40) }
chord := proc(display: Dynamic, key: UPtr) {
    send(display, 65507, 1); tap(display, key); send(display, 65507, 0); sleep_ms(40)
}
prefix := proc(display: Dynamic, key: UPtr) { chord(display, 120); tap(display, key); sleep_ms(100) }
focus := proc(display: Dynamic, window: UPtr) {
    sleep_ms(200); XSetInputFocus(display, window, 2, 0); XFlush(display); sleep_ms(100)
}
app_for := proc(home: Str, name: Str, file: Str = "") returns Cmd {
    app := Cmd.new("./bin/tiled", "--session", name)
    if file.len() > 0 { app.arg(file) }
    app.env("HOME", home).env("SHELL", "/bin/sh").env("ENV", "").env("PS1", "$ ")
    app.stdout_to("tmp/terminal-gui-app.log").stderr_to_stdout()
    return app
}
finished := proc(app: Cmd, pid: I64) {
    for _ in 0..200 { if app.poll() { break }; sleep_ms(50) }
    require(app, pid, app.poll(), "session application did not close")
    assert(app.wait() == 0)
}
checkpoint := proc(app: Cmd, pid: I64, path: Str, text: Str) returns EditorCheckpoint {
    for _ in 0..300 {
        mut error : I32 = 0
        bytes := workspace_read(path, error)
        if error == 0 {
            result := EditorCheckpoint.decode(bytes)
            if result.error.len() == 0 {
                for buffer : EditorBuffer in result.editor.buffers {
                    if buffer.text == text { return result }
                }
            }
        }
        if app.poll() { break }; sleep_ms(50)
    }
    require(app, pid, false, format("checkpoint did not contain expected text: ", text))
    return EditorCheckpoint()
}

main := proc() {
    root := get_cwd_str()
    home := format(root, "/tmp/session-gui-", process_id().to_str()); assert(mkdir_p(format(home, "/.tiled")) == 0)
    // Configured startup launches a compiled GUI child. Record its PID so the
    // crash and writer-lock tests target that child, not the waiting launcher.
    File.writefile(format(home, "/.tiled/init.til"), "mode lib\ninit := proc(mut config: TiledConfig) { config.session.enabled = true; config.session.restore = true; File.writefile(format(get_env(\"HOME\"), \"/gui-pid\"), process_id().to_str()) }\n")
    file := format(home, "/notes.txt"); File.writefile(file, "ORIGINAL")
    name := get_env("DISPLAY"); ref display : Dynamic = XOpenDisplay(name.c_str)
    if is_null(display) { panic("run under xvfb-run") }
    saved := format(home, "/.tiled/sessions/work.session")
    app := app_for(home, "work", file); pid := app.start()
    window := wait_window(app, pid, "Tiled - notes.txt"); focus(display, window)
    // Simulate geometry from a display that is no longer available on restart.
    XMoveResizeWindow(display, window, 5000, 5000, 740, 520); XFlush(display); sleep_ms(150)
    type_keys(display, "EDIT_")
    prefix(display, 51); prefix(display, 111); prefix(display, 116)
    wait_window(app, pid, "Tiled - *terminal-1*")
    type_text(display, "printf 'SAVED_TERMINAL_OUTPUT\\n'")
    live := checkpoint(app, pid, saved, "EDIT_ORIGINAL")
    require(app, pid, live.editor.views().len() == 2 && live.editor.buffers.len() == 2, "split/terminal resources missing from checkpoint")
    sleep_ms(2200) // Include the child's output in the next periodic checkpoint.
    request_close(display, window); sleep_ms(150); type_text(display, "keep"); sleep_ms(150); type_text(display, "terminate")
    finished(app, pid)
    assert(File.readfile(file) == "ORIGINAL")
    snapshot := EditorCheckpoint.decode(File.readfile(saved))
    assert(snapshot.error == "" && snapshot.editor.buffers[0].dirty)
    assert(snapshot.editor.buffers[1].text.contains("SAVED_TERMINAL_OUTPUT"))
    assert(File.readfile(saved) == File.readfile(format(saved, ".previous")))

    again := app_for(home, "work"); again_pid := again.start()
    again_window := wait_window(again, again_pid, "Tiled - *terminal-1* [saved output]"); focus(display, again_window)
    mut root_window : UPtr = 0; mut x : I32 = 0; mut y : I32 = 0
    mut width : U32 = 0; mut height : U32 = 0; mut border : U32 = 0; mut depth : U32 = 0
    XGetGeometry(display, again_window, root_window, x, y, width, height, border, depth)
    require(again, again_pid, width == 740 && height == 520 && x >= 0 && y >= 0 &&
        x.cast(I64) + width.cast(U64).cast(I64) <= 1600 && y.cast(I64) + height.cast(U64).cast(I64) <= 1200, "restored frame was not clamped to the available display")
    restored := checkpoint(again, again_pid, saved, "EDIT_ORIGINAL")
    require(again, again_pid, restored.editor.views().len() == 2, "layout was not restored")
    prefix(display, 98); type_text(display, "notes.txt"); sleep_ms(150)
    type_keys(display, "X"); chord(display, 120); chord(display, 115); sleep_ms(150)
    require(again, again_pid, File.readfile(file) == "EDIT_XORIGINAL", "buffer history point or recovered edits were lost")
    request_close(display, again_window); finished(again, again_pid)
    println("PASS: normal exit Keep, layout/history points, terminal output and file-safe restore")

    crash_file := format(home, "/crash.txt"); File.writefile(crash_file, "BASE")
    crash_path := format(home, "/.tiled/sessions/crash.session")
    crashed := app_for(home, "crash", crash_file); crashed_pid := crashed.start()
    crash_window := wait_window(crashed, crashed_pid, "Tiled - crash.txt"); focus(display, crash_window)
    type_keys(display, "CRASH_"); checkpoint(crashed, crashed_pid, crash_path, "CRASH_BASE")
    child_pid := File.readfile(format(home, "/gui-pid"))
    Cmd.new("kill", "-KILL", child_pid).run_checked(); crashed.wait()
    recovered := app_for(home, "crash"); recovered_pid := recovered.start()
    recovery_window := wait_window(recovered, recovered_pid, "Tiled - crash.txt"); focus(display, recovery_window)
    checkpoint(recovered, recovered_pid, crash_path, "CRASH_BASE")
    require(recovered, recovered_pid, File.readfile(crash_file) == "BASE", "crash recovery overwrote the file")
    request_close(display, recovery_window); sleep_ms(150); type_text(display, "discard"); finished(recovered, recovered_pid)
    discarded := EditorCheckpoint.decode(File.readfile(crash_path))
    assert(discarded.editor.buffers[0].text == "BASE" && !discarded.editor.buffers[0].dirty)
    assert(File.readfile(crash_path) == File.readfile(format(crash_path, ".previous")))
    println("PASS: crash recovery and explicit discard without resurrection")

    fresh := app_for(home, "crash"); fresh.arg("--fresh"); fresh_pid := fresh.start()
    fresh_window := wait_window(fresh, fresh_pid, "Tiled - *draft*"); focus(display, fresh_window)
    checkpoint(fresh, fresh_pid, crash_path, "")
    request_close(display, fresh_window); finished(fresh, fresh_pid)
    disabled := app_for(home, "disabled"); disabled.arg("--no-session"); disabled_pid := disabled.start()
    disabled_window := wait_window(disabled, disabled_pid, "Tiled - *draft*"); focus(display, disabled_window)
    request_close(display, disabled_window); finished(disabled, disabled_pid)
    assert(!File.exists(format(home, "/.tiled/sessions/disabled.session")))
    println("PASS: fresh start and disabled persistence")

    one_file := format(home, "/one.txt"); two_file := format(home, "/two.txt")
    File.writefile(one_file, "ONE"); File.writefile(two_file, "TWO")
    one := app_for(home, "shared", one_file); one_pid := one.start()
    one_window := wait_window(one, one_pid, "Tiled - one.txt")
    two := app_for(home, "shared", two_file); two_pid := two.start()
    two_window := wait_window(two, two_pid, "Tiled - two.txt")
    two_child := File.readfile(format(home, "/gui-pid"))
    checkpoint(one, one_pid, format(home, "/.tiled/sessions/shared.session"), "ONE")
    checkpoint(two, two_pid, format(home, "/.tiled/sessions/shared-", two_child, "-1.session"), "TWO")
    request_close(display, two_window); finished(two, two_pid)
    request_close(display, one_window); finished(one, one_pid)
    XCloseDisplay(display)
    println("PASS: concurrent GUI instances checkpoint independently")
}
