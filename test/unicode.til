mode cli
import("std/file")
import("../lib/libunicode/unicode")

hex := func(text: Str) returns I64 {
    mut value : I64 = 0
    for i in 0..text.len() {
        digit := "0123456789ABCDEF".find(text.substr(i, 1)); assert(digit >= 0)
        value = value * 16 + digit
    }
    return value
}
main := proc() {
    for code : I64 in array(I64, 0, 1, 127, 128, 255, 2047, 2048, 0xd7ff, 0xe000, 0xffff, 0x10000, 0x10ffff) {
        text := unicode_encode(code)
        decoded := unicode_read(text, 0)
        assert(decoded.valid && decoded.value == code && decoded.end == text.len() && unicode_valid(text))
        for n in 1..text.len() {
            partial := unicode_read(text.substr(0, n), 0, false)
            assert(partial.incomplete && partial.end == 0)
            final := unicode_read(text.substr(0, n), 0)
            assert(!final.valid && !final.incomplete && final.end == n && final.value == 0xfffd)
        }
    }
    assert(!unicode_scalar(-1) && !unicode_scalar(0xd800) && !unicode_scalar(0x110000))
    for first : I64 in array(I64, 0x80, 0xbf, 0xc0, 0xc1, 0xf5, 0xff) {
        text := format(Str.from_byte(first.to_u8()), "a")
        bad := unicode_read(text, 0)
        assert(!bad.valid && bad.end == 1 && bad.value == 0xfffd && !unicode_valid(text))
        assert(unicode_read(text, bad.end).value == 97)
    }
    for bytes : Str in array(Str, "ED A0 80", "E0 80 AF", "F0 80 80 AF", "F4 90 80 80") {
        mut text := ""; for byte : Str in bytes.split(" ") { text = format(text, Str.from_byte(hex(byte).to_u8())) }
        assert(!unicode_valid(text)); assert(unicode_read(text, 0).end == 1)
    }
    bad_prefix := format(Str.from_byte(0xe2), Str.from_byte(0x82), "A")
    assert(unicode_read(bad_prefix, 0).end == 2)
    assert(unicode_read(bad_prefix, 2).value == 65)
    assert(unicode_next(bad_prefix, 0) == 2 && unicode_previous(bad_prefix, 2) == 0)
    mut cases : USize = 0
    data := File.readfile("test/unicode_grapheme_cases.txt")
    for line : Str in data.split("\n") {
        comments := line.split("#"); body := comments[0].trim()
        if body.len() == 0 { continue }
        mut text := ""; mut expected := Vec(USize).new()
        for token : Str in body.split(" ") {
            if token.len() == 0 || token == "×" { continue }
            if token == "÷" { expected.push(own text.len()) }
            else { text = format(text, unicode_encode(hex(token))) }
        }
        assert(expected[0] == 0)
        for i in 1..expected.len() {
            start := expected[i - 1].clone(); end := expected[i].clone()
            if unicode_next(text, start) != end || unicode_previous(text, end) != start { panic("grapheme conformance: ", line) }
            for byte in start..end {
                assert(unicode_floor(text, byte) == start)
                mut ceil := end; if byte == start { ceil = start }
                assert(unicode_ceil(text, byte) == ceil)
            }
        }
        assert(unicode_column(text, 0, text.len()) == expected.len() - 1)
        cases++
    }
    assert(cases > 700)
    println("PASS: UTF-8 validation/streaming and ", cases, " Unicode 17.0 grapheme conformance cases")
}
