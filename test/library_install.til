mode cli
import("std/sys")
import("std/file")

get_cwd_str := ext_proc() returns Str {}

main := proc() {
    root := get_cwd_str()
    prefix := format(root, "/tmp/libterminal-install")
    consumer := format(root, "/tmp/libterminal-consumer")
    if mkdir_p(format(consumer, "/test")) != 0 || mkdir_p(format(consumer, "/tmp")) != 0 {
        panic("cannot create isolated consumer")
    }
    Cmd.new("til", "install", "--cpu=baseline", "--opt=2", "--usize=64",
        format("--prefix=", prefix), "lib/libterminal/terminal.til").run_checked()
    binding := format(prefix, "/lib/til/lib/terminal")
    escaped := binding.replace("\\", "\\\\").replace("\"", "\\\"")
    for name : Str in array(Str, "terminal_model", "terminal_input", "terminal_alternate", "terminal_scrollback", "terminal_session") {
        source := File.readfile(format("test/", name, ".til"))
        File.writefile(format(consumer, "/test/", name, ".til"),
            source.replace("../gen/terminal_api", escaped))
    }
    File.writefile(format(consumer, "/test/terminal_session_child.til"), File.readfile("test/terminal_session_child.til"))
    compiler := Cmd.new("sh", "-c", "command -v til")
    compiler.capture_out(); compiler.run_checked()
    path := compiler.out().replace("\n", "")
    for name : Str in array(Str, "terminal_model", "terminal_input", "terminal_alternate", "terminal_scrollback", "terminal_session") {
        cmd := Cmd.new(path, "run", "--cpu=baseline", "--opt=2", "--usize=64",
            "-o", format("tmp/", name), "-c", format("tmp/", name, ".c"), format("test/", name, ".til"))
        if name == "terminal_session" { cmd.arg(path) }
        cmd.cwd(consumer).env("LIBRARY_PATH", format(prefix, "/lib"))
        cmd.env("LD_LIBRARY_PATH", format(prefix, "/lib")).env("LD_RUN_PATH", format(prefix, "/lib"))
        cmd.run_checked()
    }
    // The executable's embedded runpath, not the build environment, must be
    // sufficient. No terminal implementation source is present in this cwd.
    Cmd.new(format(consumer, "/tmp/terminal_model")).cwd(consumer).run_checked()
    interpreted := Cmd.new(path, "interpret", "--usize=64", "test/terminal_model.til")
    interpreted.cwd(consumer).env("LD_LIBRARY_PATH", format(prefix, "/lib"))
    interpreted.run_checked()
    alternate := Cmd.new(path, "interpret", "--usize=64", "test/terminal_alternate.til")
    alternate.cwd(consumer).env("LD_LIBRARY_PATH", format(prefix, "/lib"))
    alternate.run_checked()
    scrollback := Cmd.new(path, "interpret", "--usize=64", "test/terminal_scrollback.til")
    scrollback.cwd(consumer).env("LD_LIBRARY_PATH", format(prefix, "/lib"))
    scrollback.run_checked()
    println("PASS: installed libterminal model/input/alternate/scrollback/session consumers outside the source tree")
}
