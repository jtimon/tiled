mode gui
import("terminal_gui_helpers")

main := proc() {
    query := Cmd.new("fc-match", "--format=%{file}", "monospace")
    query.capture_out()
    if query.run() != 0 { panic("fontconfig failed") }
    InitWindow(960, 80, "terminal GUI reference".c_str)
    SetWindowPosition(0, 1000)
    SetExitKey(0)
    mut view := TerminalView.new(query.out())
    marker := "TILMINAL_GUI_OUTPUT"
    render_reference(view, marker)
    reference := find_window("terminal GUI reference")
    assert(reference != 0)
    name := get_env("DISPLAY")
    ref display : Dynamic = XOpenDisplay(name.c_str)
    if is_null(display) { panic("run under xvfb-run") }
    root := get_cwd_str()
    fixture := format("tmp/terminal-gui-", process_id().to_str())
    assert(mkdir_p(fixture) == 0)
    marker_path := format(fixture, "/", marker)
    File.writefile(marker_path, "")
    app := Cmd.new("./tilminal")
    app.cwd("bin").env("SHELL", "/bin/sh").env("ENV", "").env("PS1", "$ ")
    app.env("HOME", format(root, "/", fixture)).env("LC_ALL", "C")
    app.stdout_to(format(root, "/tmp/terminal-gui-app.log")).stderr_to_stdout()
    pid := app.start()
    window := wait_window(app, pid, "tilminal")
    sleep_ms(250)
    XSetInputFocus(display, window, 2, 0)
    XFlush(display)
    // Only ls output, not echoed input, contains the marker filename.
    type_text(display, format("ls ../", fixture))
    check_pixels(app, pid, display, window, reference, (view.cell_width * marker.len().to_i64()).to_i32())
    File.remove(marker_path)
    Cmd.new("xmodmap", "-e", "clear control", "-e", "clear mod1",
        "-e", "keysym Control_L = Alt_L Meta_L", "-e", "keysym Alt_L = Control_L",
        "-e", "add control = Control_L Control_R",
        "-e", "add mod1 = Alt_L Alt_R Meta_L Meta_R").run_checked()
    sleep_ms(100)
    type_text(display, "sleep 30")
    sleep_ms(250)
    send(display, 65507, 1)
    send(display, 99, 1)
    send(display, 99, 0)
    send(display, 65507, 0)
    sleep_ms(150)
    next_marker := "CTRL_C_OK"
    next_path := format(fixture, "/", next_marker)
    File.writefile(next_path, "")
    render_reference(view, next_marker)
    type_text(display, format("ls ../", fixture))
    check_pixels(app, pid, display, window, reference, (view.cell_width * next_marker.len().to_i64()).to_i32())
    close_app(app, pid, display, window)
    File.remove(next_path)
    println("PASS: burst text/Enter, remapped Ctrl-C reaches foreground job, visible output and clean close")
    unicode := format(terminal_utf8(0x4e00), "e", terminal_utf8(0x301))
    render_reference(view, unicode)
    once := Cmd.new("./tilminal", format("printf '", unicode, "'"))
    once.cwd("bin").env("SHELL", "/bin/sh")
    once.stdout_to(format(root, "/tmp/terminal-gui-app.log")).stderr_to_stdout()
    once_pid := once.start()
    once_window := wait_window(once, once_pid, "tilminal [exit 0]")
    check_pixels(once, once_pid, display, once_window, reference, (view.cell_width * 3).to_i32())
    close_app(once, once_pid, display, once_window)
    println("PASS: visible Unicode output, retained final screen and one-shot exit status")
    XCloseDisplay(display)
    view.close()
    CloseWindow()
}
