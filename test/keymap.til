mode cli
import("../src/editor_commands")

insert_marker := func(mut editor: EditorState) { editor.insert("guest command") }

main := proc() {
    mut commands := EditorCommands.new()
    mut state := KeyState()
    state.context("text:0")
    assert(state.event(commands.keys, "text", false, true, 88, 2, 1).kind == 2)
    assert(state.event(commands.keys, "text", false, true, 88, 2, 2).kind == 3)
    assert(state.event(commands.keys, "text", false, true, 116, 0, 3).kind == 3)
    assert(state.event(commands.keys, "text", false, true, 84, 0, 1).command == "new-terminal")
    assert(state.event(commands.keys, "terminal", false, true, 84, 0, 2).kind == 3)
    assert(state.event(commands.keys, "text", true, true, 88, 2, 1).command == "cut")
    assert(state.event(commands.keys, "terminal", true, true, 67, 2, 1).command == "copy")
    assert(state.event(commands.keys, "terminal", false, true, 67, 2, 1).kind == 0)
    assert(state.event(commands.keys, "terminal", false, false, 266, 1, 1).kind == 0)
    assert(state.event(commands.keys, "terminal", false, true, 266, 1, 2).command == "scroll-page-up")
    assert(state.event(commands.keys, "minibuffer", false, true, 88, 2, 1).kind == 0)
    assert(state.event(commands.keys, "minibuffer", false, true, 257, 0, 1).command == "accept")
    state.context("text:after-prompt")
    assert(state.event(commands.keys, "text", false, true, 114, 0, 3).kind == 0)
    commands.bind("terminal", "C-v", "paste")
    assert(state.event(commands.keys, "terminal", false, true, 86, 2, 1).command == "paste")
    commands.bind("terminal", "C-v", "forward-key", true)
    assert(state.event(commands.keys, "terminal", false, true, 86, 2, 1).command == "forward-key")
    assert(state.event(commands.keys, "terminal", false, true, 118, 2, 3).kind == 0)
    commands.unbind("terminal", "C-v")
    assert(state.event(commands.keys, "terminal", false, true, 86, 2, 1).kind == 0)
    commands.command("insert-marker", insert_marker)
    commands.bind("text", "C-k a b", "insert-marker")
    assert(state.event(commands.keys, "text", false, true, 75, 2, 1).kind == 2)
    assert(state.event(commands.keys, "text", false, true, 65, 0, 1).kind == 2)
    result := state.event(commands.keys, "text", false, true, 66, 0, 1)
    mut editor := EditorState.new("", "")
    assert(commands.invoke(result.command, editor))
    assert(editor.buffers[0].text == "guest command")
    assert(state.event(commands.keys, "text", false, true, 98, 0, 3).kind == 3)
    assert(state.event(commands.keys, "text", false, true, 88, 2, 1).kind == 2)
    assert(state.event(commands.keys, "text", false, true, 71, 2, 1).command == "cancel")
    assert(state.pending == "")
    assert(state.event(commands.keys, "text", false, true, 88, 2, 1).kind == 2)
    assert(state.event(commands.keys, "text", false, true, 90, 0, 1).kind == 4)
    assert(state.event(commands.keys, "text", false, true, 90, 0, 2).kind == 3)
    assert(state.event(commands.keys, "text", false, true, 122, 0, 3).kind == 3)
    assert(state.event(commands.keys, "text", false, true, 88, 2, 1).kind == 2)
    state.context("terminal:1")
    assert(state.event(commands.keys, "terminal", false, true, 84, 0, 1).kind == 0)
    assert(KeyStroke.parse("C-S-v").tag() == KeyStroke.parse("S-C-V").tag())
    commands.unbind("global", "C-x")
    assert(state.event(commands.keys, "text", false, true, 88, 2, 1).kind == 0)
    commands.bind("global", "C-x", "ignore")
    assert(state.event(commands.keys, "text", false, true, 88, 2, 1).command == "ignore")
    println("PASS: keymap precedence, prefixes, repeats, forwarding, text suppression and live Til commands")
}
