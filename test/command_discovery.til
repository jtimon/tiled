mode cli
import("../src/editor_commands")
import("../src/command_discovery")

marker := func(mut editor: EditorState) { editor.insert("CALLED") }
main := proc() {
    mut commands := EditorCommands.new()
    commands.command("marker", marker)
    commands.bind("text", "F8", "save-buffer")
    assert(commands.keys.bindings_for("save-buffer", "text", false, true).contains("F8 [text]"))
    assert(commands.keys.bindings_for("save-buffer", "text", false, true).contains("C-x C-s"))
    assert(!commands.keys.bindings_for("save-buffer", "text", true, true).contains("C-x C-s"))
    assert(commands.keys.bindings_for("copy", "terminal", true, true).contains("C-c [terminal-selection]"))
    assert(!commands.keys.bindings_for("copy", "terminal", false, true).contains("C-c [terminal-selection]"))
    mut d := CommandDiscovery()
    d.begin(commands.keys, "pane", "text", false, true, true, commands.user_names(), false)
    d.mini.insert("marker")
    result := d.event(commands.keys, KeyDispatch(kind = 1, command = "accept"), 257, 0, 1)
    assert(result.kind == 1 && result.named && result.command == "marker" && !d.active())
    mut editor := EditorState.new("", "")
    assert(commands.invoke(result.command, editor))
    assert(editor.buffers[0].text == "CALLED")
    d.begin(commands.keys, "pane", "text", false, true, true, commands.user_names(), false)
    d.mini.insert("does-not-exist")
    assert(d.event(commands.keys, KeyDispatch(kind = 1, command = "accept"), 257, 0, 1).kind == 3)
    assert(d.active() && d.mini.hint.contains("matching"))
    d.mini.input = "forward-key"; d.mini.cursor = d.mini.input.len(); d.mini.refresh()
    d.event(commands.keys, KeyDispatch(kind = 1, command = "accept"), 257, 0, 1)
    assert(d.active() && d.mini.hint.contains("Unavailable"))
    d.event(commands.keys, KeyDispatch(kind = 1, command = "cancel"), 256, 0, 1)
    assert(!d.active())

    d.begin(commands.keys, "pane", "text", false, true, true, commands.user_names(), true)
    d.event(commands.keys, KeyDispatch(), 88, 2, 1)
    assert(d.reading && d.sequence == "C-x")
    d.event(commands.keys, KeyDispatch(), 83, 2, 1)
    assert(!d.active() && d.message == "C-x C-s -> save-buffer [global]")
    assert(editor.buffers[0].text == "CALLED")
    d.begin(commands.keys, "pane", "text", true, true, true, commands.user_names(), true)
    d.event(commands.keys, KeyDispatch(), 88, 2, 1)
    assert(d.message == "C-x -> cut [text-selection]" && !d.active())
    d.begin(commands.keys, "pane", "terminal", false, true, true, commands.user_names(), true)
    d.event(commands.keys, KeyDispatch(), 67, 2, 1)
    assert(d.message.contains("forwarded to child"))
    d.begin(commands.keys, "pane", "text", false, true, true, commands.user_names(), true)
    d.event(commands.keys, KeyDispatch(), 256, 0, 1)
    assert(d.message == "Escape -> quit [text]")
    d.begin(commands.keys, "pane", "text", false, true, true, commands.user_names(), true)
    d.event(commands.keys, KeyDispatch(), 88, 2, 1)
    d.event(commands.keys, KeyDispatch(), 90, 0, 1)
    assert(d.message.contains("undefined sequence") && !d.active())
    d.begin(commands.keys, "pane", "minibuffer", false, true, true, commands.user_names(), true)
    d.event(commands.keys, KeyDispatch(), 257, 0, 1)
    assert(d.message == "Enter -> accept [minibuffer]")
    d.begin(commands.keys, "pane", "terminal", false, true, false, commands.user_names(), false)
    assert(d.available("scroll-page-up"))
    d.refresh(commands.keys, "pane", "terminal", false, false)
    assert(!d.available("scroll-page-up"))
    d.refresh(commands.keys, "other-pane", "terminal", false, false)
    assert(!d.active())
    mut input := KeyState()
    input.consume(65, 0, 1)
    assert(input.event(commands.keys, "text", false, true, 97, 0, 3).kind == 3)
    println("PASS: command discovery, effective bindings, selection/prefix precedence, inspection and prompt isolation")
}
