mode cli
import("../src/editor_session")
import("../src/tilminal_tabs")

main := proc() {
    mut editor := EditorState.new("", "")
    editor.arrange(0, EditorRect(width = 1200, height = 800))
    editor.new_draft(); editor.insert("two")
    assert(editor.buffer_name(1) == "*draft-2*")
    editor.cycle_tab(-1); editor.insert("one")
    editor.cycle_tab(1)
    assert(editor.nodes[editor.focused].view.cursor == 3)
    editor.hide_tab()
    assert(editor.buffers[1].alive && editor.buffers[1].dirty)
    assert(editor.nodes[editor.focused].tabs.items.len() == 1)
    editor.switch_buffer(1)
    assert(editor.nodes[editor.focused].view.cursor == 3 && editor.nodes[editor.focused].tabs.items.len() == 2)
    assert(editor.split(true, 100, 100))
    editor.move_tab(-1)
    leaves := editor.views()
    assert(editor.nodes[leaves[0]].tabs.items[0] == 1)
    assert(editor.nodes[leaves[1]].tabs.items[0] == 0)
    editor.tabs_visible = false
    bytes := EditorCheckpoint.encode(editor, SessionFrame(), Vec(SessionTerminalOutput).new(), Vec(USize).new())
    restored := EditorCheckpoint.decode(bytes)
    assert(restored.error == "" && !restored.editor.tabs_visible)
    assert(restored.editor.nodes[restored.editor.focused].tabs.items[0] == 1)
    assert(!editor.kill_buffer(1))
    assert(editor.kill_buffer(1, true))
    for leaf : USize in editor.views() {
        assert(editor.nodes[leaf].tabs.items.len() == 1 && editor.nodes[leaf].tabs.items[0] == 0)
    }
    mut overflow := TabGroup()
    for id in 0..20 { overflow.add(id.to_usize()) }
    narrow := TabLayout.calculate(320, 42, overflow.items.len())
    assert(narrow.count == 1)
    overflow.reveal(19, narrow.count)
    assert(overflow.first == 19)
    overflow.reveal(0, narrow.count)
    assert(overflow.first == 0)
    mut old := SessionWriter()
    old.put("editor"); SessionFrame().write(old)
    old.number(3); old.number(2); old.number(1)
    old.number(1); old.put("text"); old.put(""); old.put("legacy"); old.put("legacy"); old.number(0); old.put(""); old.put("")
    old.number(2); old.put("view"); old.number(1); old.number(2)
    old.number(0); old.number(0); old.number(0); old.number(0); old.put("end")
    legacy := EditorCheckpoint.decode(old.finish())
    assert(legacy.error == "" && legacy.editor.nodes[0].tabs.items.len() == 1)
    assert(legacy.editor.nodes[0].view.cursor == 2)
    mut old_terminal := SessionWriter()
    old_terminal.put("terminal-output"); SessionFrame().write(old_terminal)
    old_terminal.put("/tmp"); old_terminal.put("old output"); old_terminal.put("end")
    migrated := TerminalWorkspace.decode(old_terminal.finish())
    assert(migrated.loaded && migrated.records.len() == 1 && migrated.active_id == 1)
    println("PASS: independent buffer tabs, reordering, dirty close, stable identities and v1 migration")

    if host_os() != "linux" { return }
    dir := format(get_cwd_str(), "/tmp/tabs-", process_id().to_str()); assert(mkdir_p(dir) == 0)
    done := format(dir, "/done")
    child_file := format(dir, "/child")
    mut tabs := TilminalTabs()
    assert(tabs.open("/bin/sh", TerminalTabRecord(id = 1), false, 20, 4, true,
        format("i=0; while [ $i -lt 10000 ]; do printf 'hidden output line\\n'; i=$((i+1)); done; printf done > ", done)))
    assert(tabs.open("/bin/sh", TerminalTabRecord(id = 2, label = "Terminal 2"), false, 20, 4, true,
        format("printf '%s' $$ > ", child_file, "; printf SECOND; read value")))
    for _ in 0..500 {
        tabs.update(20, 4)
        if File.exists(done) && File.exists(child_file) { break }
        sleep_ms(10)
    }
    assert(File.exists(done) && File.exists(child_file))
    assert(tabs.slots[tabs.current].terminal.screen.cell_at(0, 0).text == "S")
    saved := TerminalWorkspace.decode(tabs.checkpoint(SessionFrame()))
    assert(saved.loaded && saved.records.len() == 2 && saved.active_id == 2)
    child := File.readfile(child_file)
    tabs.close_current()
    check := Cmd.new("kill", "-0", child); check.capture()
    assert(check.run() != 0)
    assert(tabs.order.items.len() == 1)
    tabs.close_current()
    empty := TerminalWorkspace.decode(tabs.checkpoint(SessionFrame()))
    assert(empty.loaded && empty.records.len() == 0 && empty.active_id == 0)
    assert(tabs.open("/no-such-tab-shell", TerminalTabRecord(id = 3, output = "RECOVERED"), true, 20, 4))
    assert(tabs.slots[tabs.current].terminal.ended && tabs.slots[tabs.current].error.len() > 0)
    assert(terminal_saved_output(tabs.slots[tabs.current].terminal.screen).contains("RECOVERED"))
    tabs.close_current()
    tabs.close()
    println("PASS: hidden terminal pumping, independent screens, checkpoint order and process teardown")
}
