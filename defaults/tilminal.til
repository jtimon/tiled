mode lib

// Copy to ~/.tilminal.til. Defaults are installed before this function runs.
init := func(mut config: TilminalConfig) {
    // Output/cwd restore into a NEW shell; this does not reattach old jobs.
    // config.session.enabled = false
    // config.session.name = "work"
    config.commands.bind("terminal", "C-S-v", "paste", true)
    // To paste with plain Ctrl-V while retaining a way to send Ctrl-V:
    // config.commands.bind("terminal", "C-v", "paste")
    // config.commands.bind("terminal", "C-S-v", "forward-key", true)
    // To always interrupt on Ctrl-C, even with a selection:
    // config.commands.unbind("terminal-selection", "C-c")
}
