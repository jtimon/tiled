mode lib
import("../gen/tiled_startup_api")

// Run ./make.til, then copy gen/tiled_init.til to ~/.tiled/init.til.
// The generated copy has the correct binding path for this build.
// Tiled interprets init() in-process before opening its window.
// The command-line filename takes precedence over config.initial_file.
init := proc() {
    mut config := tiled_options()
    config.maximized = false
    config.tile_left = true
    // Dimensions used when both maximized and tile_left are false.
    config.width = 1000
    config.height = 700
    // Font size in pixels; increase or decrease this to suit your display.
    config.font_size = 28
    // Ctrl-Shift-B toggles the tab bars; sessions remember the last choice.
    config.tabs_visible = true
    // Opt in to saving/restoring opened files and tabs; see doc/sessions.org.
    // config.session.enabled = true
    // config.session.restore = true
    // config.session.name = "work"
    // config.session.interval_ms = 2000
    // Commands/keymaps are ordinary Til configuration; see doc/keybindings.org.
    // tiled_bind("terminal", "C-v", "paste")
    // tiled_bind("terminal", "C-S-v", "forward-key", true)
    // tiled_unbind("text-selection", "C-x") // Always use C-x as prefix.
    // Empty means the system monospace font, resolved through fontconfig.
    // config.font_path = "/path/to/your/monospace.ttf"
    config.draft_text = "Welcome to Tiled!\n\nC-x t: new terminal\nC-x b: switch buffer\nC-x C-b: list buffers\nC-x k: kill buffer\nC-x 2: split top/bottom\nC-x 3: split side by side\nC-x o: focus next view\nC-x 0: close view\nC-x 1: keep only this view\nC-x C-f / Ctrl+O: open a file\nC-x C-s / Ctrl+S: save text buffer\nC-x C-c: exit Tiled\n"

    // Optionally open a file instead of *draft*:
    // config.initial_file = "/path/to/notes.org"
    tiled_configure(config)
}
