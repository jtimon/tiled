mode lib
import("grapheme_data")

// Pure, host-independent UTF-8 and Unicode 17.0 extended grapheme boundaries.
// Str remains a byte string. No normalization or replacement mutates its bytes.
UnicodeScalar := struct {
    value : I64 = -1
    end : USize = 0
    valid := false
    incomplete := false
}
unicode_scalar := func(code: I64) returns Bool {
    return code >= 0 && code <= 0x10ffff && !(code >= 0xd800 && code <= 0xdfff)
}
unicode_encode := func(code: I64) returns Str {
    assert(unicode_scalar(code))
    if code < 128 { return Str.from_byte(code.to_u8()) }
    if code < 2048 { return format(Str.from_byte((192 + code / 64).to_u8()), Str.from_byte((128 + code.mod(64)).to_u8())) }
    if code < 65536 { return format(Str.from_byte((224 + code / 4096).to_u8()), Str.from_byte((128 + (code / 64).mod(64)).to_u8()), Str.from_byte((128 + code.mod(64)).to_u8())) }
    return format(Str.from_byte((240 + code / 262144).to_u8()), Str.from_byte((128 + (code / 4096).mod(64)).to_u8()), Str.from_byte((128 + (code / 64).mod(64)).to_u8()), Str.from_byte((128 + code.mod(64)).to_u8()))
}
// Malformed input consumes its maximal valid prefix and displays U+FFFD.
// Incomplete non-final input consumes nothing, so callers can append a chunk.
unicode_read := func(text: Str, start: USize, final: Bool = true) returns UnicodeScalar {
    assert(start <= text.len())
    if start == text.len() { return UnicodeScalar(end = start, incomplete = !final) }
    first := text.get(start).cast(U8).to_i64()
    if first < 128 { return UnicodeScalar(value = first, end = start + 1, valid = true) }
    mut length : USize = 0; mut value : I64 = 0
    if first >= 194 && first <= 223 { length = 2; value = first - 192 }
    if first >= 224 && first <= 239 { length = 3; value = first - 224 }
    if first >= 240 && first <= 244 { length = 4; value = first - 240 }
    if length == 0 { return UnicodeScalar(value = 0xfffd, end = start + 1) }
    mut i : USize = 1
    while i < length {
        if start + i >= text.len() {
            if !final { return UnicodeScalar(end = start, incomplete = true) }
            return UnicodeScalar(value = 0xfffd, end = text.len())
        }
        byte := text.get(start + i).cast(U8).to_i64()
        if byte < 128 || byte > 191 { return UnicodeScalar(value = 0xfffd, end = start + i) }
        if i == 1 && ((first == 224 && byte < 160) || (first == 237 && byte > 159) || (first == 240 && byte < 144) || (first == 244 && byte > 143)) {
            return UnicodeScalar(value = 0xfffd, end = start + 1)
        }
        value = value * 64 + byte - 128; i++
    }
    return UnicodeScalar(value = value, end = start + length, valid = true)
}
unicode_valid := func(text: Str) returns Bool {
    mut pos : USize = 0
    while pos < text.len() { scalar := unicode_read(text, pos); if !scalar.valid { return false }; pos = scalar.end }
    return true
}
// UAX #29 GB3..GB999. State stays within one extended grapheme cluster.
unicode_next := func(text: Str, start: USize) returns USize {
    assert(start <= text.len())
    if start == text.len() { return start }
    first := unicode_read(text, start)
    mut pos := first.end
    mut previous := unicode_grapheme_property(first.value)
    mut ri : I64 = 0; if previous == 6 { ri = 1 }
    mut pictographic := unicode_pictographic(first.value) != 0
    mut joined_emoji := false
    mut indic : I64 = 0; if unicode_incb(first.value) == 1 { indic = 1 }
    while pos < text.len() {
        scalar := unicode_read(text, pos)
        current := unicode_grapheme_property(scalar.value)
        incb := unicode_incb(scalar.value)
        ep := unicode_pictographic(scalar.value) != 0
        mut joined := false
        if previous == 1 && current == 2 { joined = true } // CR LF
        else if previous == 1 || previous == 2 || previous == 3 || current == 1 || current == 2 || current == 3 { joined = false }
        else if previous == 9 && (current == 9 || current == 10 || current == 12 || current == 13) { joined = true }
        else if (previous == 12 || previous == 10) && (current == 10 || current == 11) { joined = true }
        else if (previous == 13 || previous == 11) && current == 11 { joined = true }
        else if current == 4 || current == 5 || current == 8 || previous == 7 { joined = true }
        else if indic == 2 && incb == 1 { joined = true } // GB9c
        else if previous == 5 && joined_emoji && ep { joined = true } // GB11
        else if previous == 6 && current == 6 && ri.mod(2) == 1 { joined = true }
        if !joined { break }
        joined_emoji = current == 5 && pictographic
        if ep { pictographic = true } else if current != 4 { pictographic = false }
        if incb == 1 { indic = 1 }
        else if incb == 3 && indic > 0 { indic = 2 }
        else if incb != 2 { indic = 0 }
        if current == 6 { ri = ri + 1 } else { ri = 0 }
        previous = current; pos = scalar.end
    }
    return pos
}
// A preceding LF is a safe segmentation restart. Include a preceding CR when
// navigating over CRLF. These scans are linear in the current logical line.
priv unicode_anchor := func(text: Str, position: USize) returns USize {
    mut at := position
    while at > 0 {
        if text.get(at - 1) == '\n' { break }
        at--
    }
    return at
}
unicode_floor := func(text: Str, position: USize) returns USize {
    mut end := position; if end > text.len() { end = text.len() }
    mut at := unicode_anchor(text, end)
    while at < end { next := unicode_next(text, at); if next > end { return at }; at = next }
    return at
}
unicode_previous := func(text: Str, position: USize) returns USize {
    assert(position <= text.len())
    if position == 0 { return 0 }
    mut at := unicode_anchor(text, position - 1)
    while true { next := unicode_next(text, at); if next >= position { return at }; at = next }
}
unicode_ceil := func(text: Str, position: USize) returns USize {
    at := unicode_floor(text, position)
    if at < position { return unicode_next(text, at) }
    return at
}
unicode_column := func(text: Str, start: USize, end: USize) returns USize {
    mut at := start; mut count : USize = 0
    while at < end { at = unicode_next(text, at); count++ }
    return count
}
unicode_at_column := func(text: Str, start: USize, end: USize, column: USize) returns USize {
    mut at := start; mut count : USize = 0
    while at < end && count < column { at = unicode_next(text, at); count++ }
    if at > end { return end }
    return at
}
