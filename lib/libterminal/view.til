mode lib
import("../../gen/terminal_api")
// The application host supplies raylib through installed Til's mode gui.

TerminalGlyph := struct { code : I64; font : Font }

terminal_color := func(index: I64, bright: Bool, faint: Bool) returns Color {
    mut rgb : I64 = 0
    if index >= 0x1000000 { rgb = index - 0x1000000 }
    else if index >= 232 {
        level := 8 + (index - 232) * 10
        rgb = level * 65793
    } else if index >= 16 {
        n := index - 16
        mut r := n / 36
        mut g := (n / 6).mod(6)
        mut b := n.mod(6)
        if r > 0 { r = 55 + r * 40 }
        if g > 0 { g = 55 + g * 40 }
        if b > 0 { b = 55 + b * 40 }
        rgb = r * 65536 + g * 256 + b
    } else {
        mut n := index
        if bright && n < 8 { n = n + 8 }
        rgb = match n {
        case 0: 0x101218 case 1: 0xb84040 case 2: 0x50b850 case 3: 0xc0b050
        case 4: 0x5078c0 case 5: 0xb060b0 case 6: 0x50b8b8 case 7: 0xd8d8d8
        case 8: 0x707070 case 9: 0xff7070 case 10: 0x80ff80 case 11: 0xffff80
        case 12: 0x80a0ff case 13: 0xff80ff case 14: 0x80ffff case: 0xffffff
        }
    }
    mut r := (rgb / 65536).mod(256)
    mut g := (rgb / 256).mod(256)
    mut b := rgb.mod(256)
    if faint { r = r / 2; g = g / 2; b = b / 2 }
    return Color(r = r.to_u8(), g = g.to_u8(), b = b.to_u8(), a = 255)
}

// GPU resources belong to the view; the host calls close before destroying
// its graphics context. Screen/session ownership and input dispatch are host-owned.
TerminalView := struct {
    font : Font
    path := ""
    own glyphs := Vec(TerminalGlyph).new()
    cell_width : I64 = 12
    cell_height : I64 = 24
    bells : I64 = 0
    bell_until : F64 = 0.0

namespace:
    new := proc(path: Str) returns TerminalView {
        if FileExists(path.c_str).not() { panic("terminal font not found: ", path) }
        font := LoadFontEx(path.c_str, 20, Option(ref I32).None, 0)
        if IsFontValid(font).not() || font.baseSize != 20 { panic("cannot load terminal font: ", path) }
        if GetGlyphInfo(font, 63).value != 63 { panic("terminal font must contain a replacement '?' glyph") }
        width := MeasureTextEx(font, "M".c_str, 20, 0).x.to_i64() + 1
        return TerminalView(font = font, path = path.clone(), cell_width = width)
    }
    glyph_font := proc(mut v: TerminalView, c: I64) returns Font {
        if c >= 32 && c <= 126 { return v.font }
        for g in v.glyphs { if g.code == c { return g.font } }
        mut codes := Vec(I32).new()
        // Every atlas includes its replacement glyph. A missing character
        // is expected with a finite font; raylib must never receive an
        // empty glyph set (its atlas builder treats zero as default count).
        codes.push(own I64.to_i32(63))
        codes.push(own c.to_i32())
        font := LoadFontEx(v.path.c_str, 20, Option(ref I32).Some(codes[0]), 2)
        if IsFontValid(font).not() { panic("cannot load terminal glyph: ", c) }
        v.glyphs.push(own TerminalGlyph(code = c, font = font.clone()))
        return font
    }
    draw := proc(mut v: TerminalView, screen: TerminalScreen, left: I64, top: I64,
                 width: I64, height: I64, focused: Bool, ended: Bool) {
        v.draw_scrolled(screen, left, top, width, height, focused, ended, 0)
    }
    draw_scrolled := proc(mut v: TerminalView, screen: TerminalScreen, left: I64, top: I64,
                 width: I64, height: I64, focused: Bool, ended: Bool, offset: I64, selection: TerminalSelection = TerminalSelection.new()) {
        if width <= 0 || height <= 0 { return }
        columns := terminal_bound(width / v.cell_width, 0, screen.columns)
        rows := terminal_bound(height / v.cell_height, 0, screen.rows)
        if screen.bells != v.bells { v.bells = screen.bells; v.bell_until = GetTime() + 0.15 }
        blink_off := GetTime().to_i64().mod(2) == 1
        for y in 0..rows {
            for x in 0..columns {
                ref cell : TerminalCell = screen.display_cell(x, y, offset)
                if cell.span == 0 { continue }
                px := left + x * v.cell_width
                py := top + y * v.cell_height
                fg := terminal_color(cell.style.fg, cell.style.bold, cell.style.faint)
                bg := terminal_color(cell.style.bg, false, false)
                mut ink := fg
                mut paper := bg
                if cell.style.inverse != screen.reverse_screen { ink = bg; paper = fg }
                if selection.contains(screen, x, y, offset) {
                    paper = Color(r = 55, g = 85, b = 125, a = 255)
                    ink = Color(r = 255, g = 255, b = 255, a = 255)
                }
                cell_w := terminal_bound(v.cell_width * cell.span, 0, left + width - px)
                DrawRectangle(px.to_i32(), py.to_i32(), cell_w.to_i32(), v.cell_height.to_i32(), paper)
                if cell.style.hidden.or(cell.style.blink.and(blink_off)) { continue }
                BeginScissorMode(px.to_i32(), py.to_i32(), cell_w.to_i32(), v.cell_height.to_i32())
                mut pos : USize = 0
                mut pen : F32 = 0
                while pos < cell.text.len() {
                    code := terminal_decode(cell.text, pos, true)
                    font := v.glyph_font(code)
                    DrawTextCodepoint(font, code.to_i32(), Vector2(x = px.to_f32() + pen, y = py.to_f32()), 20, ink)
                    if terminal_width(code) > 0 { pen = GetGlyphInfo(font, code.to_i32()).advanceX.to_f32() }
                }
                if cell.style.underline { DrawRectangle(px.to_i32(), (py + v.cell_height - 3).to_i32(), cell_w.to_i32(), 1, ink) }
                EndScissorMode()
            }
        }
        if offset == 0 && focused && screen.cursor_visible && !ended && !blink_off && screen.x < columns && screen.y < rows {
            x := left + screen.x * v.cell_width
            y := top + screen.y * v.cell_height
            DrawRectangleLines(x.to_i32(), y.to_i32(), v.cell_width.to_i32(), v.cell_height.to_i32(), Color(r = 255, g = 255, b = 255, a = 255))
        }
        if GetTime() < v.bell_until {
            DrawRectangleLines(left.to_i32(), top.to_i32(), (columns * v.cell_width).to_i32(), (rows * v.cell_height).to_i32(), Color(r = 255, g = 255, b = 255, a = 255))
        }
    }
    close := proc(v: TerminalView) {
        for g in v.glyphs { UnloadFont(g.font) }
        UnloadFont(v.font)
    }
}
