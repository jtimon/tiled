mode lib

import("text")

TerminalStyle := struct {
    fg : I64 = 7
    bg : I64 = 0
    bold := false
    faint := false
    underline := false
    blink := false
    inverse := false
    hidden := false
namespace:
    new := func() returns TerminalStyle { return TerminalStyle() }
}

TerminalCell := struct {
    text := " "
    span : I64 = 1 // 0 = continuation, 1 = ordinary, 2 = wide base
    wrap_next := false // Set on the last cell when output soft-wraps this row.
    wrap_padding := false // Unused final column before a wide glyph wraps.
    style := TerminalStyle.new()
namespace:
    blank_default := func() returns TerminalCell { return TerminalCell() }
    append := func(mut c: TerminalCell, text: Str) { c.text = format(c.text, text) }
}

terminal_bound := func(n: I64, lo: I64, hi: I64) returns I64 {
    if n < lo { return lo }
    if n > hi { return hi }
    return n
}

// Cursor presentation saved by DECSC/DECRC and by each screen page. Parser
// state, tabs and terminal-wide input modes do not belong to a page.
TerminalCursor := struct {
    x : I64 = 0
    y : I64 = 0
    style := TerminalStyle.new()
    g0 := false
    g1 := false
    use_g1 := false
    origin := false
    wrap := true
    pending_wrap := false
namespace:
    new := func() returns TerminalCursor { return TerminalCursor() }
    clamp := func(mut cursor: TerminalCursor, columns: I64, rows: I64) {
        cursor.x = terminal_bound(cursor.x, 0, columns - 1)
        cursor.y = terminal_bound(cursor.y, 0, rows - 1)
        cursor.pending_wrap = false
    }
}

priv terminal_resized_cells := func(cells: Vec(TerminalCell), old_columns: I64, old_rows: I64,
                               columns: I64, rows: I64) returns Vec(TerminalCell) {
    mut resized := Vec(TerminalCell).new()
    for y in 0..rows {
        for x in 0..columns {
            if y < old_rows && x < old_columns { resized.push(own cells[(y * old_columns + x).to_usize()].clone()) }
            else { resized.push(own TerminalCell()) }
        }
    }
    return resized
}

TerminalHistoryRow := struct { own cells := Vec(TerminalCell).new() }

TerminalScreen := struct {
    columns : I64 = 1
    rows : I64 = 1
    priv own cells := Vec(TerminalCell).new()
    priv own tabs := Vec(Bool).new()
    priv own history := Vec(TerminalHistoryRow).new()
    priv history_head : I64 = 0
    priv history_limit : I64 = 2000
    history_total : I64 = 0
    history_generation : I64 = 0
    revision : I64 = 0
    bracketed_paste := false
    priv history_blank := TerminalCell.blank_default()
    alternate_active := false
    priv own other_cells := Vec(TerminalCell).new()
    priv other_cursor := TerminalCursor.new()
    priv other_saved := TerminalCursor.new()
    priv other_top : I64 = 0
    priv other_bottom : I64 = 0
    x : I64 = 0
    y : I64 = 0
    top : I64 = 0
    bottom : I64 = 0
    style := TerminalStyle.new()
    saved_style := TerminalStyle.new()
    saved_x : I64 = 0
    saved_y : I64 = 0
    wrap := true
    pending_wrap := false
    origin := false
    insert := false
    newline := false
    cursor_visible := true
    application_cursor := false
    application_keypad := false
    reverse_screen := false
    bells : I64 = 0
    g0_graphics := false
    g1_graphics := false
    use_g1 := false
    saved_g0 := false
    saved_g1 := false
    saved_use_g1 := false
    saved_origin := false
    saved_wrap := true
    saved_pending_wrap := false
    parser : I64 = 0
    control := ""
    pending := ""
    replies := ""

namespace:
    new := func(columns: I64, rows: I64) returns TerminalScreen {
        if columns < 1 || rows < 1 { panic("terminal dimensions must be positive") }
        mut s := TerminalScreen(columns = columns, rows = rows, bottom = rows - 1)
        for _ in 0..(columns * rows) { s.cells.push(own TerminalCell()) }
        for i in 0..columns { s.tabs.push(own i.mod(8).eq(0)) }
        return s
    }

    index := func(s: TerminalScreen, x: I64, y: I64) returns USize {
        return (y * s.columns + x).to_usize()
    }

    // Borrowed until the next feed/resize. Keep element addressing inside the
    // library instead of making consumers interpret a foreign Vec's stride.
    cell_at := func(s: TerminalScreen, x: I64, y: I64) returns ref TerminalCell {
        return s.cells[s.index(x, y)]
    }

    history_rows := func(s: TerminalScreen) returns I64 { return s.history.len().to_i64() }

    clear_history := func(mut s: TerminalScreen) {
        s.revision++
        s.history = Vec(TerminalHistoryRow).new()
        s.history_head = 0; s.history_total = 0
        s.history_generation++
    }

    // Changing the capacity starts a fresh history. Zero disables recording.
    set_history_limit := func(mut s: TerminalScreen, rows: I64) {
        if rows < 0 { panic("negative terminal history limit") }
        s.clear_history()
        s.history_limit = rows
    }

    priv remember := func(mut s: TerminalScreen, amount: I64) {
        if s.alternate_active || s.top != 0 || s.bottom != s.rows - 1 || s.history_limit == 0 { return }
        for y in 0..terminal_bound(amount, 0, s.rows) {
            mut row := TerminalHistoryRow()
            for x in 0..s.columns { row.cells.push(own s.cell_at(x, y).clone()) }
            if s.history_rows() < s.history_limit { s.history.push(own row) }
            else {
                s.history.set(s.history_head.to_usize(), own row)!
                s.history_head = (s.history_head + 1).mod(s.history_limit)
            }
            s.history_total++
        }
    }

    // Logical rows: retained history followed by the live page. History keeps
    // its original width; resizing clips/pads without destructive reflow.
    display_cell := func(s: TerminalScreen, x: I64, y: I64, offset: I64) returns ref TerminalCell {
        if s.alternate_active { return s.cell_at(x, y) }
        row := s.history_rows() + y - terminal_bound(offset, 0, s.history_rows())
        if row >= s.history_rows() { return s.cell_at(x, row - s.history_rows()) }
        ref saved : TerminalHistoryRow = s.history[((s.history_head + row).mod(s.history_rows())).to_usize()]
        if x >= saved.cells.len().to_i64() { return s.history_blank }
        ref cell : TerminalCell = saved.cells[x.to_usize()]
        if cell.span == 2 && x + 1 >= s.columns { return s.history_blank }
        return cell
    }

    display_history_rows := func(s: TerminalScreen) returns I64 {
        if s.alternate_active { return 0 }
        return s.history_rows()
    }
    row_wraps := func(s: TerminalScreen, row: I64) returns Bool {
        count := s.display_history_rows()
        if row >= count { return s.cell_at(s.columns - 1, row - count).wrap_next }
        ref saved : TerminalHistoryRow = s.history[((s.history_head + row).mod(count)).to_usize()]
        return saved.cells[saved.cells.len() - 1].wrap_next
    }
    row_padding := func(s: TerminalScreen, row: I64) returns Bool {
        count := s.display_history_rows()
        if row >= count { return s.cell_at(s.columns - 1, row - count).wrap_padding }
        ref saved : TerminalHistoryRow = s.history[((s.history_head + row).mod(count)).to_usize()]
        return saved.cells.len().to_i64() == s.columns && saved.cells[saved.cells.len() - 1].wrap_padding
    }

    priv current_cursor := func(s: TerminalScreen) returns TerminalCursor {
        mut cursor := TerminalCursor.new()
        cursor.x = s.x; cursor.y = s.y; cursor.style = s.style
        cursor.g0 = s.g0_graphics; cursor.g1 = s.g1_graphics; cursor.use_g1 = s.use_g1
        cursor.origin = s.origin; cursor.wrap = s.wrap; cursor.pending_wrap = s.pending_wrap
        return cursor
    }

    priv saved_cursor := func(s: TerminalScreen) returns TerminalCursor {
        mut cursor := TerminalCursor.new()
        cursor.x = s.saved_x; cursor.y = s.saved_y; cursor.style = s.saved_style
        cursor.g0 = s.saved_g0; cursor.g1 = s.saved_g1; cursor.use_g1 = s.saved_use_g1
        cursor.origin = s.saved_origin; cursor.wrap = s.saved_wrap; cursor.pending_wrap = s.saved_pending_wrap
        return cursor
    }

    priv apply_cursor := func(mut s: TerminalScreen, cursor: TerminalCursor) {
        s.style = cursor.style
        s.g0_graphics = cursor.g0; s.g1_graphics = cursor.g1; s.use_g1 = cursor.use_g1
        s.origin = cursor.origin; s.wrap = cursor.wrap
        s.move_to(cursor.x, cursor.y)
        s.pending_wrap = cursor.pending_wrap && s.wrap && cursor.x == s.x && cursor.y == s.y && s.x == s.columns - 1
    }

    priv store_saved := func(mut s: TerminalScreen, cursor: TerminalCursor) {
        s.saved_x = cursor.x; s.saved_y = cursor.y; s.saved_style = cursor.style
        s.saved_g0 = cursor.g0; s.saved_g1 = cursor.g1; s.saved_use_g1 = cursor.use_g1
        s.saved_origin = cursor.origin; s.saved_wrap = cursor.wrap; s.saved_pending_wrap = cursor.pending_wrap
    }

    priv switch_screen := func(mut s: TerminalScreen, alternate: Bool) {
        if alternate == s.alternate_active { return }
        if s.other_cells.len() == 0 {
            for _ in 0..(s.columns * s.rows) { s.other_cells.push(own s.blank()) }
            mut initial := s.current_cursor()
            initial.x = 0; initial.y = 0; initial.pending_wrap = false
            s.other_cursor = initial
            s.other_bottom = s.rows - 1
        }
        cursor := s.current_cursor()
        saved := s.saved_cursor()
        next_cursor := s.other_cursor.clone()
        next_saved := s.other_saved.clone()
        top := s.top; bottom := s.bottom
        cells := s.cells.take()
        s.cells = s.other_cells.take()
        s.other_cells = cells
        s.top = s.other_top; s.bottom = s.other_bottom
        s.other_top = top; s.other_bottom = bottom
        s.other_cursor = cursor; s.other_saved = saved
        s.apply_cursor(next_cursor)
        s.store_saved(next_saved)
        s.alternate_active = alternate
    }

    priv alternate_mode := func(mut s: TerminalScreen, mode: I64, enabled: Bool) {
        // Invalidate even hidden viewport anchors if an entire alternate-screen
        // visit occurs between host updates. Internal resize swaps do not count.
        if mode != 1048 && enabled && !s.alternate_active { s.history_generation++ }
        if mode == 1048 {
            if enabled { s.save() } else { s.restore() }
        } else if mode == 47 {
            s.switch_screen(enabled)
        } else if mode == 1047 {
            if !enabled && s.alternate_active { s.erase(0, s.columns * s.rows) }
            s.switch_screen(enabled)
        } else if mode == 1049 {
            // Modes select one of two pages, not a nesting stack. Repeated
            // entry must not overwrite the primary cursor or erase live output.
            if enabled && !s.alternate_active {
                s.save()
                s.switch_screen(true)
                s.erase(0, s.columns * s.rows)
                s.move_to(0, 0)
            } else if !enabled && s.alternate_active {
                s.switch_screen(false)
                s.restore()
            }
        }
    }

    blank := func(s: TerminalScreen) returns TerminalCell {
        return TerminalCell(style = s.style)
    }

    // Erasing either half of a wide cell removes the whole glyph.
    erase_cell := func(mut s: TerminalScreen, x: I64, y: I64) {
        idx := s.index(x, y)
        span := s.cells[idx].span
        if span == 0 && x > 0 { s.cells[idx - 1] = s.blank() }
        if span == 2 && x + 1 < s.columns { s.cells[idx + 1] = s.blank() }
        s.cells[idx] = s.blank()
    }

    erase := func(mut s: TerminalScreen, first: I64, end: I64) {
        for i in first..end { s.erase_cell(i.mod(s.columns), i / s.columns) }
    }

    scroll := func(mut s: TerminalScreen, first: I64, last: I64, amount: I64) {
        n := terminal_bound(amount, 0 - (last - first + 1), last - first + 1)
        if n > 0 {
            for y in first..(last + 1) {
                for x in 0..s.columns {
                    idx := s.index(x, y)
                    if y + n <= last { s.cells[idx] = s.cells[s.index(x, y + n)].clone() }
                    else { s.cells[idx] = s.blank() }
                }
            }
        } else if n < 0 {
            mut y := last
            while y >= first {
                for x in 0..s.columns {
                    idx := s.index(x, y)
                    if y + n >= first { s.cells[idx] = s.cells[s.index(x, y + n)].clone() }
                    else { s.cells[idx] = s.blank() }
                }
                y--
            }
        }
    }

    linefeed := func(mut s: TerminalScreen, soft: Bool = false, padding: Bool = false) {
        ref mut last : TerminalCell = s.cells[s.index(s.columns - 1, s.y)]
        last.wrap_next = soft
        last.wrap_padding = padding
        s.pending_wrap = false
        if s.y == s.bottom { s.remember(1); s.scroll(s.top, s.bottom, 1) }
        else if s.y < s.rows - 1 { s.y = s.y + 1 }
    }

    move_to := func(mut s: TerminalScreen, x: I64, y: I64) {
        s.x = terminal_bound(x, 0, s.columns - 1)
        mut lo : I64 = 0
        mut hi := s.rows - 1
        if s.origin { lo = s.top; hi = s.bottom }
        s.y = terminal_bound(y, lo, hi)
        s.pending_wrap = false
    }

    move_vertical := func(mut s: TerminalScreen, amount: I64) {
        mut lo : I64 = 0
        mut hi := s.rows - 1
        if s.y >= s.top && s.y <= s.bottom { lo = s.top; hi = s.bottom }
        s.move_to(s.x, terminal_bound(s.y + amount, lo, hi))
    }

    repair_row := func(mut s: TerminalScreen, y: I64) {
        for x in 0..s.columns {
            idx := s.index(x, y)
            if s.cells[idx].span == 0 {
                if x == 0 { s.cells[idx] = s.blank() }
                else if s.cells[idx - 1].span != 2 { s.cells[idx] = s.blank() }
            } else if s.cells[idx].span == 2 {
                if x == s.columns - 1 { s.cells[idx] = s.blank() }
                else if s.cells[idx + 1].span != 0 { s.cells[idx] = s.blank() }
            }
        }
    }

    shift := func(mut s: TerminalScreen, amount: I64) {
        n := terminal_bound(amount, s.x - s.columns, s.columns - s.x)
        if n > 0 {
            mut x := s.columns - 1
            while x >= s.x {
                if x - n >= s.x { s.cells[s.index(x, s.y)] = s.cells[s.index(x - n, s.y)].clone() }
                else { s.cells[s.index(x, s.y)] = s.blank() }
                x--
            }
        } else if n < 0 {
            for x in s.x..s.columns {
                if x - n < s.columns { s.cells[s.index(x, s.y)] = s.cells[s.index(x - n, s.y)].clone() }
                else { s.cells[s.index(x, s.y)] = s.blank() }
            }
        }
        s.repair_row(s.y)
    }

    put := func(mut s: TerminalScreen, scalar: I64) {
        mut c := scalar
        graphics := s.g0_graphics
        mut use_graphics := graphics
        if s.use_g1 { use_graphics = s.g1_graphics }
        if use_graphics && c >= 95 && c <= 126 { c = terminal_dec_graphic(c) }
        mut width := terminal_width(c)
        if width == 0 {
            mut x := s.x - 1
            if s.pending_wrap { x = s.x }
            if x >= 0 {
                idx := s.index(x, s.y)
                mut base := idx
                if s.cells[idx].span == 0 && x > 0 { base-- }
                s.cells[base].append(terminal_utf8(c))
            }
            return
        }
        // A two-column glyph cannot fit a one-column pane. Display a
        // replacement, rather than leaving an orphan continuation cell.
        if width > s.columns { c = 0xfffd; width = 1 }
        if s.pending_wrap || s.x + width > s.columns {
            if s.wrap {
                padding := !s.pending_wrap && s.x + width > s.columns
                s.x = 0; s.linefeed(true, padding)
            }
            else { s.x = s.columns - width }
        }
        s.pending_wrap = false
        if s.insert { s.shift(width) }
        for x in s.x..(s.x + width) { s.erase_cell(x, s.y) }
        s.cells[s.index(s.x, s.y)] = TerminalCell(text = terminal_utf8(c), span = width, style = s.style)
        if width == 2 { s.cells[s.index(s.x + 1, s.y)] = TerminalCell(text = "", span = 0, style = s.style) }
        s.x = s.x + width
        if s.x >= s.columns { s.x = s.columns - 1; s.pending_wrap = s.wrap }
    }

    resize := func(mut s: TerminalScreen, columns: I64, rows: I64) {
        if columns < 1 || rows < 1 { panic("terminal dimensions must be positive") }
        if columns == s.columns && rows == s.rows { return }
        s.revision++
        cells := terminal_resized_cells(s.cells, s.columns, s.rows, columns, rows)
        if s.other_cells.len() > 0 {
            s.other_cells = terminal_resized_cells(s.other_cells, s.columns, s.rows, columns, rows)
        }
        mut tabs := Vec(Bool).new()
        for x in 0..columns {
            if x < s.columns { tabs.push(own s.tabs[x.to_usize()].clone()) }
            else { tabs.push(own x.mod(8).eq(0)) }
        }
        s.cells = cells
        s.tabs = tabs
        s.columns = columns
        s.rows = rows
        s.top = 0
        s.bottom = rows - 1
        s.other_top = 0; s.other_bottom = rows - 1
        s.other_cursor.clamp(columns, rows)
        s.other_saved.clamp(columns, rows)
        mut saved := s.saved_cursor()
        saved.clamp(columns, rows)
        s.store_saved(saved)
        s.move_to(s.x, s.y)
        for y in 0..rows { s.repair_row(y) }
        if s.other_cells.len() > 0 {
            original := s.alternate_active
            s.switch_screen(!original)
            for y in 0..rows { s.repair_row(y) }
            s.switch_screen(original)
        }
    }

    save := func(mut s: TerminalScreen) {
        s.store_saved(s.current_cursor())
    }

    restore := func(mut s: TerminalScreen) {
        s.apply_cursor(s.saved_cursor())
    }

    take_replies := func(mut s: TerminalScreen) returns Str {
        out := s.replies.clone()
        s.replies = ""
        return out
    }

    csi := func(mut s: TerminalScreen, final: I64) {
        mut p := Vec(I64).new()
        mut value : I64 = 0
        mut private := false
        mut unsupported := false
        for b in s.control {
            c := b.cast(U8).to_i64()
            if c == 63 { private = true }
            else if c >= 48 && c <= 57 { value = terminal_bound(value * 10 + c - 48, 0, 1000000) }
            else if c == 59 { p.push(own value.clone()); value = 0 }
            else { unsupported = true }
        }
        p.push(own value.clone())
        if unsupported { return } // Unsupported CSI intermediates/subparameters.
        a := p[0].clone()
        n := terminal_bound(a, 1, 1000000)
        mut b : I64 = 0
        if p.len() > 1 { b = p[1] }
        if final == 104 || final == 108 {
            enabled := final == 104
            for mode in p {
                if private {
                    switch mode {
                    case 1: s.application_cursor = enabled
                    case 5: s.reverse_screen = enabled
                    case 6:
                        s.origin = enabled
                        if enabled { s.move_to(0, s.top) } else { s.move_to(0, 0) }
                    case 7: s.wrap = enabled; s.pending_wrap = false
                    case 25: s.cursor_visible = enabled
                    case 2004: s.bracketed_paste = enabled
                    case 47, 1047, 1048, 1049: s.alternate_mode(mode, enabled)
                    }
                } else {
                    if mode == 4 { s.insert = enabled }
                    if mode == 20 { s.newline = enabled }
                }
            }
            return
        }
        if private { return }
        switch final {
        case 65: s.move_vertical(0 - n)
        case 66: s.move_vertical(n)
        case 67: s.move_to(s.x + n, s.y)
        case 68: s.move_to(s.x - n, s.y)
        case 69: s.move_to(0, s.y + n)
        case 70: s.move_to(0, s.y - n)
        case 71: s.move_to(n - 1, s.y)
        case 72, 102:
            mut row := n - 1
            if s.origin { row = row + s.top }
            s.move_to(terminal_bound(b, 1, 1000000) - 1, row)
        case 100:
            mut row := n - 1
            if s.origin { row = row + s.top }
            s.move_to(s.x, row)
        case 74:
            cursor := s.y * s.columns + s.x
            if a == 0 { s.erase(cursor, s.rows * s.columns) }
            if a == 1 { s.erase(0, cursor + 1) }
            if a == 2 { s.erase(0, s.rows * s.columns) }
            if a == 3 && !s.alternate_active { s.clear_history() }
        case 75:
            start := s.y * s.columns
            if a == 0 { s.erase(start + s.x, start + s.columns) }
            if a == 1 { s.erase(start, start + s.x + 1) }
            if a == 2 { s.erase(start, start + s.columns) }
        case 76:
            if s.y >= s.top && s.y <= s.bottom { s.scroll(s.y, s.bottom, 0 - n) }
        case 77:
            if s.y >= s.top && s.y <= s.bottom { s.scroll(s.y, s.bottom, n) }
        case 64: s.shift(n)
        case 80: s.shift(0 - n)
        case 88: s.erase(s.y * s.columns + s.x, s.y * s.columns + terminal_bound(s.x + n, 0, s.columns))
        case 83: s.remember(n); s.scroll(s.top, s.bottom, n)
        case 84: s.scroll(s.top, s.bottom, 0 - n)
        case 103:
            if a == 0 { s.tabs[s.x.to_usize()] = false }
            if a == 3 { for mut t in s.tabs { t = false } }
        case 109: s.sgr(p)
        case 110:
            if a == 5 { s.replies = format(s.replies, terminal_escape("[0n")) }
            if a == 6 {
                mut row := s.y + 1
                if s.origin { row = row - s.top }
                s.replies = format(s.replies, terminal_escape(format("[", row.to_str(), ";", (s.x + 1).to_str(), "R")))
            }
        case 99:
            if a == 0 { s.replies = format(s.replies, terminal_escape("[?1;2c")) }
        case 114:
            mut last := b
            if last == 0 { last = s.rows }
            if n < last && last <= s.rows {
                s.top = n - 1; s.bottom = last - 1
                mut row : I64 = 0
                if s.origin { row = s.top }
                s.move_to(0, row)
            }
        case 115: s.save()
        case 117: s.restore()
        }
    }

    sgr := func(mut s: TerminalScreen, p: Vec(I64)) {
        mut i : USize = 0
        while i < p.len() {
            n := p[i].clone()
            switch n {
            case 0: s.style = TerminalStyle.new()
            case 1: s.style.bold = true
            case 2: s.style.faint = true
            case 4: s.style.underline = true
            case 5: s.style.blink = true
            case 7: s.style.inverse = true
            case 8: s.style.hidden = true
            case 22: s.style.bold = false; s.style.faint = false
            case 24: s.style.underline = false
            case 25: s.style.blink = false
            case 27: s.style.inverse = false
            case 28: s.style.hidden = false
            case 30..37: s.style.fg = n - 30
            case 40..47: s.style.bg = n - 40
            case 90..97: s.style.fg = n - 90 + 8
            case 100..107: s.style.bg = n - 100 + 8
            case 39: s.style.fg = 7
            case 49: s.style.bg = 0
            case 38, 48:
                mut color : I64 = -1
                if i + 2 < p.len() && p[i + 1] == 5 {
                    color = terminal_bound(p[i + 2], 0, 255); i = i + 2
                } else if i + 4 < p.len() && p[i + 1] == 2 {
                    color = 0x1000000 + terminal_bound(p[i + 2], 0, 255) * 65536 + terminal_bound(p[i + 3], 0, 255) * 256 + terminal_bound(p[i + 4], 0, 255)
                    i = i + 4
                }
                if color >= 0 {
                    if n == 38 { s.style.fg = color } else { s.style.bg = color }
                }
            }
            i++
        }
    }

    feed := func(mut s: TerminalScreen, bytes: Str, final: Bool = false) {
        if bytes.len() > 0 { s.revision++ }
        data := format(s.pending, bytes)
        s.pending = ""
        mut pos : USize = 0
        while pos < data.len() {
            b := data[pos].cast(U8).to_i64()
            // OSC and other strings are intentionally not rendered. They
            // terminate on ST; OSC also accepts BEL. Retain only parser state.
            if s.parser >= 3 && s.parser <= 6 {
                if b == 24 || b == 26 { s.parser = 0 }
                else if b == 7 && (s.parser == 3 || s.parser == 5) { s.parser = 0 }
                else if b == 92 && s.parser >= 5 { s.parser = 0 }
                else if b == 27 {
                    if s.parser == 3 || s.parser == 5 { s.parser = 5 } else { s.parser = 6 }
                } else if s.parser == 5 { s.parser = 3 }
                else if s.parser == 6 { s.parser = 4 }
                pos++; continue
            }
            if b == 27 { s.parser = 1; s.control = ""; pos++; continue }
            if b == 24 || b == 26 { s.parser = 0; pos++; continue }
            if b < 32 || b == 127 {
                switch b {
                case 7: s.bells = s.bells + 1
                case 8: s.move_to(s.x - 1, s.y)
                case 9:
                    mut x := s.x + 1
                    while x < s.columns - 1 && s.tabs[x.to_usize()].not() { x++ }
                    s.move_to(x, s.y)
                case 10, 11, 12: s.linefeed(); if s.newline { s.x = 0 }
                case 13: s.move_to(0, s.y)
                case 14: s.use_g1 = true
                case 15: s.use_g1 = false
                }
                pos++; continue
            }
            if s.parser == 1 {
                s.parser = 0
                switch b {
                case 91: s.parser = 2
                case 93: s.parser = 3
                case 80, 88, 94, 95: s.parser = 4
                case 40: s.parser = 7
                case 41: s.parser = 8
                case 35, 37: s.parser = 9
                case 55: s.save()
                case 56: s.restore()
                case 61: s.application_keypad = true
                case 62: s.application_keypad = false
                case 68: s.linefeed()
                case 69: s.x = 0; s.linefeed()
                case 77:
                    if s.y == s.top { s.scroll(s.top, s.bottom, -1) }
                    else { s.move_to(s.x, s.y - 1) }
                case 72: s.tabs[s.x.to_usize()] = true
                case 90: s.replies = format(s.replies, terminal_escape("[?1;2c"))
                case 99:
                    mut fresh := TerminalScreen.new(s.columns, s.rows)
                    fresh.history_limit = s.history_limit
                    fresh.history_generation = s.history_generation + 1
                    fresh.revision = s.revision + 1
                    s = fresh
                }
                pos++; continue
            }
            if s.parser == 7 || s.parser == 8 {
                if s.parser == 7 { s.g0_graphics = b == 48 } else { s.g1_graphics = b == 48 }
                s.parser = 0; pos++; continue
            }
            if s.parser == 9 { s.parser = 0; pos++; continue }
            if s.parser == 2 || s.parser == 10 {
                if b >= 64 && b <= 126 {
                    if s.parser == 2 { s.csi(b) }
                    s.parser = 0; s.control = ""
                } else if s.parser == 2 {
                    if s.control.len() < 128 { s.control = format(s.control, terminal_byte(b)) }
                    else { s.parser = 10; s.control = "" }
                }
                pos++; continue
            }
            c := terminal_decode(data, pos, final)
            if c == -1 { s.pending = data.substr(pos, data.len() - pos).clone(); break }
            s.put(c)
        }
    }
}

TerminalSelection := struct {
    anchor : I64 = 0
    point : I64 = 0
    revision : I64 = 0
    dragging := false
namespace:
    new := func() returns TerminalSelection { return TerminalSelection() }
    active := func(s: TerminalSelection) returns Bool { return s.anchor != s.point }
    clear := func(mut s: TerminalSelection) { s.anchor = 0; s.point = 0; s.dragging = false }
    sync := func(mut s: TerminalSelection, screen: TerminalScreen) {
        if s.revision != screen.revision { s.clear(); s.revision = screen.revision }
    }
    position := func(screen: TerminalScreen, x: I64, y: I64, offset: I64) returns I64 {
        history := screen.display_history_rows()
        row := history + terminal_bound(y, 0, screen.rows - 1) - terminal_bound(offset, 0, history)
        return row * screen.columns + terminal_bound(x, 0, screen.columns)
    }
    begin := func(mut s: TerminalSelection, screen: TerminalScreen, x: I64, y: I64, offset: I64) {
        s.revision = screen.revision; s.dragging = true
        s.anchor = TerminalSelection.position(screen, x, y, offset); s.point = s.anchor
    }
    extend := func(mut s: TerminalSelection, screen: TerminalScreen, x: I64, y: I64, offset: I64) {
        s.sync(screen)
        if s.dragging { s.point = TerminalSelection.position(screen, x, y, offset) }
    }
    contains := func(s: TerminalSelection, screen: TerminalScreen, x: I64, y: I64, offset: I64) returns Bool {
        if s.revision != screen.revision || !s.active() { return false }
        mut start := s.anchor; mut end := s.point
        if start > end { start = s.point; end = s.anchor }
        mut pos := TerminalSelection.position(screen, x, y, offset)
        ref cell : TerminalCell = screen.display_cell(x, y, offset)
        mut span := cell.span
        if span == 0 { pos--; span = 2 }
        return pos < end && pos + span > start
    }
    text := func(s: TerminalSelection, screen: TerminalScreen) returns Str {
        if s.revision != screen.revision || !s.active() { return "" }
        mut start := s.anchor; mut end := s.point
        if start > end { start = s.point; end = s.anchor }
        mut out := ""
        history := screen.display_history_rows()
        for row in (start / screen.columns)..((end - 1) / screen.columns + 1) {
            mut line := ""
            mut y := row - history; mut offset : I64 = 0
            if row < history { y = 0; offset = history - row }
            for x in 0..screen.columns {
                ref cell : TerminalCell = screen.display_cell(x, y, offset)
                if x == screen.columns - 1 && screen.row_padding(row) { continue }
                if cell.span > 0 && s.contains(screen, x, y, offset) { line = format(line, cell.text) }
            }
            boundary := end >= (row + 1) * screen.columns
            wraps := screen.row_wraps(row)
            if boundary && !wraps {
                mut n := line.len()
                while n > 0 {
                    if line.get(n - 1) != ' ' { break }
                    n--
                }
                out = format(out, line.substr(0, n), "\n")
            } else { out = format(out, line) }
        }
        return out
    }
}

// One viewport per host pane, independent of the shared session/GPU resources.
TerminalViewport := struct {
    selection := TerminalSelection.new()
    priv clipboard_text := false
    offset : I64 = 0
    priv total : I64 = 0
    priv generation : I64 = 0
namespace:
    new := func() returns TerminalViewport { return TerminalViewport() }
    sync := func(mut v: TerminalViewport, s: TerminalScreen) {
        v.selection.sync(s)
        if v.generation != s.history_generation || s.alternate_active { v.offset = 0 }
        else if v.offset > 0 { v.offset = v.offset + s.history_total - v.total }
        v.offset = terminal_bound(v.offset, 0, s.history_rows())
        v.total = s.history_total; v.generation = s.history_generation
    }
    // 1 copy, 2 paste, 3 consumed/cancelled, 0 forward to the child.
    clipboard_command := func(mut v: TerminalViewport, s: TerminalScreen, key: I64, mods: I32, action: I32) returns I64 {
        v.sync(s)
        if action == 3 && v.clipboard_text { return 3 }
        if action != 1 && action != 2 { return 0 }
        if key >= 340 && key <= 347 { return 0 }
        v.clipboard_text = false
        ctrl := mods.band(2) != 0
        alt := mods.band(4) != 0
        shift := mods.band(1) != 0
        if (ctrl && !alt && key == 67 && (shift || v.selection.active())) || (alt && !ctrl && key == 87) {
            v.clipboard_text = true; return 1
        }
        if ctrl && !alt && ((shift && key == 86) || key == 89) {
            v.clipboard_text = true; v.offset = 0; v.selection.clear(); return 2
        }
        if ctrl && !alt && key == 71 && v.selection.active() {
            v.clipboard_text = true; v.selection.clear(); return 3
        }
        return 0
    }
    scroll := func(mut v: TerminalViewport, s: TerminalScreen, lines: I64) {
        v.sync(s)
        if !s.alternate_active { v.offset = terminal_bound(v.offset + lines, 0, s.history_rows()) }
    }
    // True consumes navigation. Other actual input returns only this view to live.
    event := func(mut v: TerminalViewport, s: TerminalScreen, key: I64, mods: I32, action: I32, rows: I64) returns Bool {
        v.sync(s)
        if !s.alternate_active && mods.band(7) == 1 && (key == 266 || key == 267) && (action == 1 || action == 2) {
            mut amount := terminal_bound(rows - 1, 1, s.rows)
            if key == 267 { amount = 0 - amount }
            v.scroll(s, amount)
            return true
        }
        if action == 3 || ((action == 1 || action == 2) && (key < 340 || key > 347)) {
            v.offset = 0; v.selection.clear()
        }
        return false
    }
}

terminal_paste := func(s: TerminalScreen, text: Str) returns Str {
    // Clipboard data is text, not terminal protocol. In particular an embedded
    // ESC must not terminate bracketed paste before the user's text ends.
    normalized := text.replace("\r\n", "\n").replace("\r", "\n").replace(terminal_escape(""), "").replace(Str.from_byte(0), "")
    if normalized.len() == 0 { return "" }
    if s.bracketed_paste { return format(terminal_escape("[200~"), normalized, terminal_escape("[201~")) }
    return normalized.replace("\n", "\r")
}

terminal_dec_graphic := func(c: I64) returns I64 {
    return match c {
    case 95: 32 case 96: 0x25c6 case 97: 0x2592
    case 98: 0x2409 case 99: 0x240c case 100: 0x240d case 101: 0x240a
    case 102: 0xb0 case 103: 0xb1 case 104: 0x2424 case 105: 0x240b
    case 106: 0x2518 case 107: 0x2510 case 108: 0x250c case 109: 0x2514
    case 110: 0x253c case 111: 0x23ba case 112: 0x23bb case 113: 0x2500
    case 114: 0x23bc case 115: 0x23bd case 116: 0x251c case 117: 0x2524
    case 118: 0x2534 case 119: 0x252c case 120: 0x2502 case 121: 0x2264
    case 122: 0x2265 case 123: 0x3c0 case 124: 0x2260 case 125: 0xa3
    case 126: 0xb7 case: c
    }
}

// Raylib key values, kept here so key encoding is headless-testable.
terminal_key := func(s: TerminalScreen, key: I64, shift: Bool, control: Bool, alt: Bool) returns Str {
    if s.application_keypad && key >= 320 && key <= 336 {
        mut code : I64 = 0
        if key <= 329 { code = 112 + key - 320 }
        else {
            code = match key { case 330: 110 case 331: 111 case 332: 106 case 333: 109 case 334: 107 case 335: 77 case 336: 88 case: 0 }
        }
        return terminal_escape(format("O", terminal_byte(code)))
    }
    mut out := ""
    mut suffix := ""
    switch key {
    case 256: out = terminal_byte(27)
    case 257, 335:
        out = terminal_byte(13)
        if s.newline { out = format(out, terminal_byte(10)) }
    case 258:
        if shift { out = terminal_escape("[Z") } else { out = terminal_byte(9) }
    case 259: out = terminal_byte(8)
    case 260: out = terminal_escape("[2~")
    case 261: out = terminal_escape("[3~")
    case 262: suffix = "C"
    case 263: suffix = "D"
    case 264: suffix = "B"
    case 265: suffix = "A"
    case 266: out = terminal_escape("[5~")
    case 267: out = terminal_escape("[6~")
    case 268: suffix = "H"
    case 269: suffix = "F"
    case 290: out = terminal_escape("OP")
    case 291: out = terminal_escape("OQ")
    case 292: out = terminal_escape("OR")
    case 293: out = terminal_escape("OS")
    case 294: out = terminal_escape("Ot")
    case 295: out = terminal_escape("Ou")
    case 296: out = terminal_escape("Ov")
    case 297: out = terminal_escape("Ol")
    case 298: out = terminal_escape("Ow")
    case 299: out = terminal_escape("Ox")
    case 300: out = terminal_escape("[23~")
    case 301: out = terminal_escape("[24~")
    }
    if suffix.len() > 0 {
        mut mod : I64 = 1
        if shift { mod = mod + 1 }
        if alt { mod = mod + 2 }
        if control { mod = mod + 4 }
        if mod > 1 { return terminal_escape(format("[1;", mod.to_str(), suffix)) }
        if s.application_cursor { return terminal_escape(format("O", suffix)) }
        return terminal_escape(format("[", suffix))
    }
    if control && key >= 64 && key <= 95 { out = terminal_byte(key - 64) }
    if control && key == 32 { out = terminal_byte(0) }
    if alt && out.len() > 0 { return terminal_escape(out) }
    return out
}

terminal_keypad_scalar := func(key: I64) returns I64 {
    if key >= 320 && key <= 329 { return 48 + key - 320 }
    return match key { case 330: 46 case 331: 47 case 332: 42 case 333: 45 case 334: 43 case 336: 61 case: -1 }
}
